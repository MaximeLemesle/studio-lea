---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import '../../styles/service.css';
import '../../styles/pages/service-redaction.css';
import { AFFICHER_TEMOIGNAGES } from '../../lib/site';
---

<Base title="Rédactionnel · Studio Béa" description="Articles, newsletters, communiqués de presse et textes de site : des mots justes pour parler de votre activité." active="services">
<!-- 1. ACCROCHE -->
<section class="grid-brown dark s-hero" style="position:relative;padding:76px 0 116px;color:#F7F0DC">
  <div class="wrap s-hero-grid" style="display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:64px;align-items:center">
    <div class="s-hero-text" style="position:relative;display:flex;flex-direction:column;gap:20px">
      <nav class="crumb" aria-label="Fil d'Ariane" style="color:#F3E9B5"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><a href="/services/" style="color:#F3E9B5">Services</a><span aria-hidden="true">/</span><span>Rédactionnel</span></nav>
      <span class="label dots" style="align-self:flex-start;padding:8px 16px;border-radius:10px 10px 0 0;background-color:#CFE3C4;color:#4A2018;font-size:12px">Dossier 04</span>
      <h1 class="h1 s-h1" style="font-size:68px;color:#F7F0DC;margin-top:-12px">Rédactionnel</h1>
      <p class="script s-accroche" data-anim="write" aria-hidden="true" style="--d:.4s;font-size:66px;color:#F3E9B5;margin:-14px 0 0 200px;transform:rotate(-5deg)">les mots justes</p>
      <p class="lead s-lead" style="max-width:600px;color:#F7F0DC">J'écris vos articles SEO, vos newsletters et vos communiqués de presse, pensés pour vos lecteurs… et pour Google.</p>
      <div class="s-hero-cta" data-m-stack style="display:flex;flex-wrap:wrap;gap:18px;margin-top:8px">
        <a class="btn btn-primary on-dark" href="/contact/">Recevoir mon devis sous 24 h</a>
      </div>
    </div>
    <div class="s-hero-visual" style="position:relative;height:500px">
      <div class="polaroid s-pol1" data-anim="drop" style="--d:200ms;position:absolute;left:80px;top:-10px;width:290px;transform:rotate(-4deg)">
        <div class="washi washi-dots" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-4deg)"></div>
        <Img src="services-redaction.jpg" alt="Communiqués de presse, newsletter et article SEO rédigés par Léa" style="display:block;width:100%;aspect-ratio:800/1110;object-fit:cover" />
        <p class="polaroid-cap">des mots qui sonnent juste</p>
      </div>
      <div class="s-price" data-anim="swing" style="--d:1.1s;position:absolute;left:60px;bottom:-30px;transform:rotate(-6deg);filter:drop-shadow(3px 5px 0 rgba(0,0,0,.25))">
        <div class="kraft" style="position:relative;padding:14px 28px 14px 48px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%);color:#4A2018;display:flex;flex-direction:column">
          <span class="tag-hole" style="left:15px"></span>
          <span class="spec" style="font-weight:700">à partir de</span>
          <span class="serif" style="font-size:30px;line-height:1.1">30 €</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. POUR QUI -->
<section class="grid-sage s-pourqui" style="position:relative;padding:110px 0 120px">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px 48px;margin-bottom:56px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Pour qui ?</p>
        <h2 class="h2">C'est pour vous si…</h2>
      </div>
    </div>
    <div class="s-postits" data-stagger="200ms" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px">
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(-2deg);display:flex;flex-direction:column;gap:12px">
        <div class="washi washi-dots" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-3deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">1.</p>
        <p class="h3" style="font-size:24px">Écrire, ce n'est pas votre truc.</p>
        <p class="small">Vous savez ce que vous voulez dire, mais pas comment le formuler.</p>
      </div>
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(1.5deg);display:flex;flex-direction:column;gap:12px;background-color:#CFE3C4">
        <div class="washi washi-plain" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(3deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">2.</p>
        <p class="h3" style="font-size:24px">Google ne vous trouve pas.</p>
        <p class="small">Des articles optimisés vous aident à remonter dans les recherches.</p>
      </div>
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(-1deg);display:flex;flex-direction:column;gap:12px">
        <div class="washi washi-floral" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-2deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">3.</p>
        <p class="h3" style="font-size:24px">Vous voulez garder le lien avec vos clients.</p>
        <p class="small">Une newsletter ou des articles réguliers pour rester dans leur tête.</p>
      </div>
    </div>
    <div class="s-bonne" style="margin-top:96px;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:18px 28px;text-align:center">
      <p class="script" style="font-size:58px;line-height:1">Bonne nouvelle :</p>
      <p class="h3" style="font-size:26px;max-width:560px;text-align:left">vous savez ce que vous voulez dire, je trouve les mots.</p>
      <a class="btn btn-primary" href="/contact/">On en parle</a>
    </div>
  </div>
</section>

<!-- 5. FORMULES -->
<section class="grid-cream s-formules" style="position:relative;padding:120px 0 116px">
  <div class="wrap">
    <div style="position:relative;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px 48px;margin-bottom:60px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Tarifs</p>
        <h2 class="h2">Les formules</h2>
        <p class="script s-sur" data-anim="write" aria-hidden="true" style="font-size:66px;margin:-10px 0 0 230px;transform:rotate(-5deg)">ou sur-mesure</p>
      </div>
    </div>

    <div class="s-formules-grid" data-stagger="200ms" style="position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:30px;align-items:stretch">
      <article class="formule lined shadow" data-anim="land" style="padding:46px 26px 30px;transform:rotate(-1.2deg)">
        <div class="washi washi-plain" style="width:110px;top:-15px;left:30px;transform:rotate(-5deg)"></div>
        <p class="label">Formule 1</p>
        <h3 class="h3">L'article SEO</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div class="kraft"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">50 €</span></div></div>
        <p class="small">Un article de blog optimisé pour remonter sur Google.</p>
        <a class="btn btn-secondary" href="/contact/?formule=redac-article" style="align-self:stretch;margin-top:auto;padding:0 12px;font-size:12px;letter-spacing:.1em">Choisir cette formule</a>
      </article>
      <article class="formule lined shadow" data-anim="land" style="padding:46px 26px 30px;transform:rotate(.8deg)">
        <div class="washi washi-dots" style="width:110px;top:-15px;left:50%;margin-left:-55px;transform:rotate(3deg)"></div>
        <p class="label">Formule 2</p>
        <h3 class="h3">La newsletter</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div style="background:#F3E9B5"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">30 €</span></div></div>
        <p class="small">Une newsletter pour garder le lien avec vos clients.</p>
        <a class="btn btn-secondary" href="/contact/?formule=redac-newsletter" style="align-self:stretch;margin-top:auto;padding:0 12px;font-size:12px;letter-spacing:.1em">Choisir cette formule</a>
      </article>
      <article class="formule lined shadow" data-anim="land" style="padding:46px 26px 30px;transform:rotate(-.8deg)">
        <div class="washi washi-floral" style="width:110px;top:-15px;left:40px;transform:rotate(-4deg)"></div>
        <p class="label">Formule 3</p>
        <h3 class="h3">Le communiqué de presse</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div class="kraft"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">50 €</span></div></div>
        <p class="small">Un communiqué pour annoncer votre actualité aux médias.</p>
        <a class="btn btn-secondary" href="/contact/?formule=redac-communique" style="align-self:stretch;margin-top:auto;padding:0 12px;font-size:12px;letter-spacing:.1em">Choisir cette formule</a>
      </article>

      <article class="formule postit" data-anim="land" style="padding:46px 26px 30px;transform:rotate(-.6deg);outline:2px dashed rgba(74,32,24,.45);outline-offset:-12px">
        <div class="washi washi-floral" style="width:110px;top:-15px;right:30px;transform:rotate(6deg)"></div>
        <p class="label">Sur-mesure</p>
        <p class="script" style="font-size:54px;line-height:.9;margin:4px 0 2px;white-space:nowrap">votre formule</p>
        <p class="small">Un article par mois, une newsletter régulière, plusieurs communiqués… On construit votre formule ensemble, à partir de vos besoins et de votre budget.</p>
        <div style="margin-top:auto;padding-top:8px"><a class="btn btn-primary" href="/contact/">Parlons-en</a></div>
      </article>
    </div>

    <div style="margin-top:96px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 14px">
      <p class="label" style="margin-right:6px">Dans toutes les formules</p>
      <span class="chip-incl">Votre ton respecté</span>
      <span class="chip-incl">Pensé pour Google</span>
      <span class="chip-incl">1 relecture incluse</span>
      <span class="chip-incl">Livré sous 24 h</span>
    </div>
  </div>
</section>

<!-- 3. INCLUS + LIVRABLES -->
<section class="grid-sage s-inclus" style="position:relative;padding:120px 0">
  <div class="wrap s-inclus-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(460px,100%),1fr));gap:64px;align-items:start">
    <div style="position:relative">
    <div class="lined shadow s-inclus-card" style="position:relative;padding:48px 48px 40px;transform:rotate(-1deg)">
      <div class="washi washi-plain" style="width:120px;top:-15px;left:40px;transform:rotate(-6deg)"></div>
      <p class="label">Le contenu du dossier</p>
      <h2 class="h2" style="font-size:40px;margin:8px 0 22px">Ce qui est inclus</h2>
      <ul class="check" data-stagger="160ms">
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#CFE3C4" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Articles de blog</b> optimisés pour le référencement (SEO).</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#CFE3C4" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Communiqués de presse</b> pour annoncer votre actualité.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#CFE3C4" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Newsletters</b> pour garder le lien avec vos clients.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#CFE3C4" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Votre ton</b>, respecté d'un bout à l'autre.</span></li>
      </ul>
    </div>
    </div>

    <div style="position:relative;display:flex;flex-direction:column;gap:14px;padding-top:12px">
      <p class="label">Ce que vous recevez</p>
      <h2 class="h2" style="font-size:40px;margin-bottom:22px">Les livrables</h2>
      <div class="s-ltags" data-stagger="180ms" style="display:flex;flex-direction:column;gap:20px">
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;transform:rotate(-2deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div class="kraft" style="position:relative;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Votre formule</p></div></div>
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;margin-left:40px;transform:rotate(1.5deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div style="position:relative;background:#F3E9B5;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Textes relus, prêts à publier</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- 4. DÉROULÉ -->
<section class="grid-cream s-deroule" style="position:relative;padding:116px 0 124px;color:#4A2018">
  <div class="wrap">
    <div class="s-deroule-head" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;margin-bottom:64px">
      <p class="label" style="color:#4A2018">— Le déroulé</p>
      <div style="position:relative">
        <h2 class="h2" style="color:#4A2018">Comment ça se passe</h2>
        <svg data-anim="draw" style="position:absolute;left:0;bottom:-16px;width:100%;height:18px" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C60 6 120 20 180 10 S270 8 296 12" fill="none" stroke="#C9A43A" stroke-width="5" stroke-linecap="round"></path></svg>
      </div>
    </div>
    <div style="position:relative">
      <svg class="s-dash d-only" data-anim="draw" style="position:absolute;left:4%;right:4%;top:34px;width:92%;height:6px" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><path d="M0 3 H100" stroke="rgba(74,32,24,.5)" stroke-width="2" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"></path></svg>
      <ol class="s-steps" data-stagger="180ms" style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:22px;color:#4A2018">
        <li class="bristol step" data-anim="land" style="transform:rotate(-2deg)"><span class="step-n">1</span><h3 class="h3" style="font-size:22px">Échange</h3><p class="small" style="font-size:15px">On parle de vous et de vos objectifs.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(1.5deg);margin-top:20px"><span class="step-n">2</span><h3 class="h3" style="font-size:22px">Brief et ton</h3><p class="small" style="font-size:15px">On définit vos sujets, vos lecteurs et votre façon de parler.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(-1deg)"><span class="step-n">3</span><h3 class="h3" style="font-size:22px">Rédaction</h3><p class="small" style="font-size:15px">J'écris vos textes.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(2deg);margin-top:20px"><span class="step-n">4</span><h3 class="h3" style="font-size:22px">Relecture</h3><p class="small" style="font-size:15px">Vous relisez, on ajuste ensemble.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(-1.5deg)"><span class="step-n">5</span><h3 class="h3" style="font-size:22px">Livraison</h3><p class="small" style="font-size:15px">Vos textes sont prêts à publier.</p></li>
      </ol>
    </div>
  </div>
</section>

<!-- 6. PROJETS LIÉS -->
<section id="projets" class="grid-brown dark s-projets" style="position:relative;padding:110px 0 120px;color:#F7F0DC">
  <div class="wrap">
    <div class="s-projets-head" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label" style="color:#F3E9B5">— Projets liés</p>
        <h2 class="h2" style="color:#F7F0DC">Ils m'ont confié leurs textes</h2>
      </div>
      <a class="link s-allpf" href="/portfolio/" style="color:#F3E9B5">Tout le portfolio →</a>
    </div>
    <div class="s-proj-track" data-carousel data-stagger="220ms" style="position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,360px));justify-content:center;gap:56px;align-items:start;color:#4A2018">
      <article class="s-proj" data-anim="drop">
        <a href="/portfolio/salon-des-peches/" data-projet="salon-des-peches" data-onglet="redac" aria-label="Voir le projet Salon des Pêches en grand" style="display:block;text-decoration:none;color:inherit">
        <div class="polaroid" style="transform:rotate(-3deg);padding:14px 14px 58px">
          <div class="washi washi-dots" style="width:112px;top:-15px;left:50%;margin-left:-56px;transform:rotate(-5deg)"></div>
          <Img src="redac-newsletters.jpg" alt="Newsletters rédigées pour le Salon des Pêches" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top" />
          <p class="polaroid-cap" style="font-size:25px">Salon des Pêches</p>
        </div>
        </a>
      </article>
      <article class="s-proj" data-anim="drop" style="margin-top:50px">
        <a href="/portfolio/medusor/" data-projet="medusor" data-onglet="redac" aria-label="Voir le projet Médusor en grand" style="display:block;text-decoration:none;color:inherit">
        <div class="polaroid" style="transform:rotate(2deg);padding:14px 14px 58px">
          <div class="washi washi-plain" style="width:112px;top:-14px;left:28px;transform:rotate(-8deg)"></div>
          <Img src="redac-communiques.jpg" alt="Communiqués de presse et newsletter rédigés pour Médusor" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top" />
          <p class="polaroid-cap" style="font-size:25px">Médusor</p>
        </div>
        </a>
      </article>
    </div>
    <div class="pager m-only" data-pager aria-hidden="true"><span></span><span></span></div>
    <a class="link s-allpf m-only" href="/portfolio/" style="color:#F3E9B5">Tout le portfolio →</a>
  </div>
</section>

<!-- TÉMOIGNAGE -->
{AFFICHER_TEMOIGNAGES && (
<section class="grid-cream s-temoin" style="position:relative;padding:110px 0 110px">
  <div class="wrap" style="display:flex;flex-direction:column;align-items:center;gap:30px">
    <div style="display:flex;flex-direction:column;align-items:center;gap:8px">
      <p class="label">— Ils en parlent</p>
      <h2 class="h2">Le mot de mes clients</h2>
    </div>
    <figure class="lined shadow s-quote" data-anim="stick" style="position:relative;margin:0;max-width:760px;padding:52px 56px 40px;transform:rotate(-1deg);color:#4A2018">
      <div class="washi washi-dots" style="width:120px;top:-15px;left:50%;margin-left:-60px;transform:rotate(3deg)"></div>
      <span class="script" aria-hidden="true" style="position:absolute;left:22px;top:-6px;font-size:120px;line-height:1;color:#C9A43A">“</span>
      <blockquote class="lead" style="margin:0"><span class="a-completer">À compléter</span></blockquote>
      <figcaption class="note" style="margin-top:16px;font-size:24px"><span class="a-completer">À compléter</span></figcaption>
    </figure>
  </div>
</section>
)}

<!-- 7. FAQ -->
<section class="grid-sage s-faq" style="position:relative;padding:110px 0 120px">
  <div class="wrap">
    <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:52px">
      <p class="label">— FAQ</p>
      <h2 class="h2">Vos questions</h2>
    </div>
    <div class="s-faq-grid" data-accordion="mobile" data-first-open-mobile style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(480px,100%),1fr));gap:28px 40px;align-items:start">
      <details class="bristol faq" open="" style="transform:rotate(-.8deg)">
        <summary><span class="h3" style="font-size:21px">Quels types de textes rédigez-vous ?</span><svg class="plus" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 3 V19 M3 11 H19" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round"></path></svg></summary>
        <p class="small" style="padding:18px 22px 24px;line-height:30px">Des articles de blog optimisés pour le référencement (SEO), des newsletters et des communiqués de presse.</p>
      </details>
      <details class="bristol faq" style="transform:rotate(.6deg)">
        <summary><span class="h3" style="font-size:21px">Écrivez-vous pour le référencement Google (SEO) ?</span><svg class="plus" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 3 V19 M3 11 H19" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round"></path></svg></summary>
        <p class="small" style="padding:18px 22px 24px;line-height:30px">Oui.</p>
      </details>
      <details class="bristol faq" style="transform:rotate(.5deg)">
