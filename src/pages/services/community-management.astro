---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import '../../styles/service.css';
import '../../styles/pages/service-cm.css';
---

<Base title="Studio Béa — Community management" active="services">
<!-- 1. ACCROCHE -->
<section class="grid-brown dark s-hero" style="position:relative;padding:76px 0 116px;color:#F7F0DC">
  <div class="wrap s-hero-grid" style="display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:64px;align-items:center">
    <div class="s-hero-text" style="position:relative;display:flex;flex-direction:column;gap:20px">
      <nav class="crumb" aria-label="Fil d'Ariane" style="color:#F3E9B5"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><a href="/services/" style="color:#F3E9B5">Services</a><span aria-hidden="true">/</span><span>Community management</span></nav>
      <span class="label dots" style="align-self:flex-start;padding:8px 16px;border-radius:10px 10px 0 0;background-color:#F2E3A0;color:#4A2018;font-size:12px">Dossier 01</span>
      <h1 class="h1 s-h1" style="font-size:68px;color:#F7F0DC;margin-top:-12px">Community<br>management</h1>
      <p class="script s-accroche" data-anim="write" aria-hidden="true" style="--d:.4s;font-size:66px;color:#F3E9B5;margin:-14px 0 0 220px;transform:rotate(-5deg)">vos réseaux, sereinement</p>
      <p class="lead s-lead" style="max-width:600px;color:#F7F0DC">Des réseaux réguliers, cohérents, et qui donnent envie de vous contacter. Je m'occupe de tout : stratégie, posts, publication, réponses et suivi. Vous, vous gardez du temps pour votre métier.</p>
      <div class="s-hero-cta" data-m-stack style="display:flex;flex-wrap:wrap;gap:18px;margin-top:8px">
        <a class="btn btn-primary on-dark" href="/contact/">Recevoir mon devis sous 24 h</a>
      </div>
    </div>
    <div class="s-hero-visual" style="position:relative;height:500px">
      <div class="polaroid s-pol1" data-anim="drop" style="--d:200ms;position:absolute;left:-10px;top:20px;width:250px;transform:rotate(-5deg)">
        <Img src="services-cm.jpg" alt="Exemple de feed Instagram réalisé pour Nutraclear" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top" />
        <p class="polaroid-cap">un feed cohérent</p>
      </div>
      <div class="polaroid s-pol2" data-anim="drop" style="--d:550ms;position:absolute;right:-30px;top:120px;width:220px;transform:rotate(5deg)">
        <div class="washi washi-dots" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-4deg)"></div>
        <Img src="projet-salon-peches.jpg" alt="Équipe du Salon des Pêches" style="display:block;width:100%;aspect-ratio:4/3;object-fit:cover" />
      </div>
      <div class="s-price" data-anim="swing" style="--d:1.1s;position:absolute;left:60px;bottom:-30px;transform:rotate(-6deg);filter:drop-shadow(3px 5px 0 rgba(0,0,0,.25))">
        <div class="kraft" style="position:relative;padding:14px 28px 14px 48px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%);color:#4A2018;display:flex;flex-direction:column">
          <span class="tag-hole" style="left:15px"></span>
          <span class="spec" style="font-weight:700">dès</span>
          <span class="serif" style="font-size:30px;line-height:1.1">200 € / mois</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. POUR QUI -->
<section class="grid-sage s-pourqui" style="position:relative;padding:110px 0 120px">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px 48px;margin-bottom:56px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Pour qui ?</p>
        <h2 class="h2">Vous vous reconnaissez ?</h2>
      </div>
    </div>
    <div class="s-postits" data-stagger="200ms" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px">
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(-2deg);display:flex;flex-direction:column;gap:12px">
        <div class="washi washi-dots" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-3deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">1.</p>
        <p class="h3" style="font-size:24px">Vous manquez de temps pour publier régulièrement.</p>
        <p class="small">Vos réseaux passent toujours après le reste, et ça se voit.</p>
      </div>
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(1.5deg);display:flex;flex-direction:column;gap:12px;background-color:#F2E3A0">
        <div class="washi washi-plain" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(3deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">2.</p>
        <p class="h3" style="font-size:24px">Vous publiez déjà, mais sans vraie stratégie.</p>
        <p class="small">Vous postez « quand vous pouvez » sans savoir ce qui fonctionne.</p>
      </div>
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(-1deg);display:flex;flex-direction:column;gap:12px">
        <div class="washi washi-floral" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-2deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">3.</p>
        <p class="h3" style="font-size:24px">Vous voulez une image cohérente qui donne confiance.</p>
        <p class="small">Un feed qui vous ressemble et qui donne envie de vous contacter.</p>
      </div>
    </div>
    <div class="s-bonne" style="margin-top:96px;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:18px 28px;text-align:center">
      <p class="script" style="font-size:58px;line-height:1">Bonne nouvelle :</p>
      <p class="h3" style="font-size:26px;max-width:560px;text-align:left">c'est exactement ce que je règle pour vous, chaque mois.</p>
      <a class="btn btn-primary" href="/contact/">On en parle</a>
    </div>
  </div>
</section>

<!-- 5. FORMULES -->
<section class="grid-cream s-formules" style="position:relative;padding:120px 0 116px">
  <div class="wrap">
    <div style="position:relative;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px 48px;margin-bottom:60px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Tarifs</p>
        <h2 class="h2">Les formules</h2>
        <p class="script s-sur" data-anim="write" aria-hidden="true" style="font-size:66px;margin:-10px 0 0 230px;transform:rotate(-5deg)">ou sur-mesure</p>
      </div>
    </div>

    <div class="s-formules-grid" data-stagger="220ms" style="position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;align-items:stretch">
      <!-- Formule 1 -->
      <article class="formule lined shadow" data-anim="land" style="transform:rotate(-1.2deg)">
        <div class="washi washi-plain" style="width:110px;top:-15px;left:30px;transform:rotate(-5deg)"></div>
        <p class="label">Formule 1</p>
        <h3 class="h3">L'essentiel</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div class="kraft"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">200 € <span style="font-size:20px">/ mois</span></span></div></div>
        <ul class="mini">
          <li>4 posts par mois</li>
          <li>Création, planification et publication</li>
          <li>Réponses aux commentaires et aux messages privés</li>
          <li>Reporting mensuel</li>
        </ul>
        <p class="note" style="font-size:20px;margin-top:auto">Idéal pour démarrer avec un petit budget.</p>
        <a class="btn btn-secondary" href="/contact/?formule=cm-essentiel" style="align-self:flex-start">Choisir L'essentiel</a>
      </article>

      <!-- Formule 2 -->
      <article class="formule lined" data-anim="land" style="transform:rotate(.8deg) scale(1.04);box-shadow:0 0 0 3px #4A2018,0 18px 34px rgba(40,15,10,.22)">
        <div class="washi washi-dots" style="width:110px;top:-15px;left:50%;margin-left:-55px;transform:rotate(3deg)"></div>
        <div class="sticker s-conseil" data-anim="sticker" style="--d:1.2s;position:absolute;right:-28px;top:-30px;width:132px;height:74px;transform:rotate(10deg)">
          <svg width="132" height="74" viewBox="-6 -6 212 122" aria-hidden="true"><path d="M50 95 C22 95 10 78 16 62 C4 52 14 30 34 34 C38 14 62 8 76 22 C86 4 120 4 128 24 C146 12 172 22 168 44 C190 48 192 78 170 86 C168 98 150 102 140 96 C126 106 100 106 90 98 C78 106 58 104 50 95 Z" fill="#FFFDF6" stroke="#FFFDF6" stroke-width="12" stroke-linejoin="round"></path><path d="M50 95 C22 95 10 78 16 62 C4 52 14 30 34 34 C38 14 62 8 76 22 C86 4 120 4 128 24 C146 12 172 22 168 44 C190 48 192 78 170 86 C168 98 150 102 140 96 C126 106 100 106 90 98 C78 106 58 104 50 95 Z" fill="#EFC9D2" stroke="#4A2018" stroke-width="1.6"></path></svg>
          <span class="note" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;padding-top:4px">mon conseil</span>
        </div>
        <p class="label">Formule 2</p>
        <h3 class="h3">La régulière</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div style="background:#F3E9B5"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">400 € <span style="font-size:20px">/ mois</span></span></div></div>
        <ul class="mini">
          <li>8 posts par mois</li>
          <li>Création, planification et publication</li>
          <li>Réponses aux commentaires et aux messages privés</li>
          <li>Reporting mensuel</li>
        </ul>
        <p class="note" style="font-size:20px;margin-top:auto">La formule à privilégier pour des résultats optimaux.</p>
        <a class="btn btn-primary" href="/contact/?formule=cm-reguliere" style="align-self:flex-start">Choisir La régulière</a>
      </article>

      <!-- Sur-mesure -->
      <article class="formule postit" data-anim="land" style="transform:rotate(-.6deg);outline:2px dashed rgba(74,32,24,.45);outline-offset:-12px">
        <div class="washi washi-floral" style="width:110px;top:-15px;right:30px;transform:rotate(6deg)"></div>
        <p class="label">Sur-mesure</p>
        <p class="script" style="font-size:64px;line-height:.9;margin:4px 0 2px">votre formule</p>
        <p class="small">Plusieurs réseaux, un lancement, de la publicité Meta Ads, un mélange avec l'UGC ou le graphisme… On construit votre formule ensemble, à partir de vos besoins et de votre budget.</p>
        <div style="margin-top:auto;padding-top:8px"><a class="btn btn-primary" href="/contact/">Parlons-en</a></div>
      </article>
    </div>


    <div style="display:flex;justify-content:center;margin-top:76px">
      <div class="dots s-option" style="position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;max-width:860px;padding:14px 22px;background-color:#F2E3A0;border:2px dashed rgba(74,32,24,.45);border-radius:10px;transform:rotate(-.5deg)">
        <span class="label" style="font-size:11px">En option</span>
        <span class="h3" style="font-size:19px">Présence proactive · + 100 € / mois</span>
        <span class="small" style="font-size:15px">Commentaires, abonnements ciblés et échanges dans des groupes pour booster votre compte.</span>
      </div>
    </div>
    <p class="note" style="margin-top:30px;text-align:center;font-size:24px">Sans engagement : les formules sont mensuelles.</p>
  </div>
</section>

<!-- 3. INCLUS + LIVRABLES -->
<section class="grid-sage s-inclus" style="position:relative;padding:120px 0">
  <div class="wrap s-inclus-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(460px,100%),1fr));gap:64px;align-items:start">
    <div class="lined shadow s-inclus-card" style="position:relative;padding:48px 48px 40px;transform:rotate(-1deg)">
      <div class="washi washi-plain" style="width:120px;top:-15px;left:40px;transform:rotate(-6deg)"></div>
      <p class="label">Le contenu du dossier</p>
      <h2 class="h2" style="font-size:40px;margin:8px 0 22px">Ce qui est inclus</h2>
      <ul class="check" data-stagger="160ms">
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F2E3A0" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Stratégie éditoriale</b> : objectifs, cibles, piliers de contenu, ton.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F2E3A0" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Création de contenus</b></span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F2E3A0" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Planification et publication</b> sur vos réseaux.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F2E3A0" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Reporting</b> mensuel et recommandations.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F2E3A0" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Réponses aux commentaires et messages</b></span></li>
      </ul>
    </div>

    <div style="position:relative;display:flex;flex-direction:column;gap:14px;padding-top:12px">
      <p class="label">Ce que vous recevez</p>
      <h2 class="h2" style="font-size:40px;margin-bottom:22px">Les livrables</h2>
      <div class="s-ltags" data-stagger="180ms" style="display:flex;flex-direction:column;gap:20px">
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;transform:rotate(-2deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div class="kraft" style="position:relative;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Stratégie éditoriale (PDF, le 1er mois)</p></div></div>
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;margin-left:40px;transform:rotate(1.5deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div style="position:relative;padding:16px 30px 16px 52px;background:#F3E9B5;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Calendrier éditorial mensuel</p></div></div>
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;transform:rotate(-1deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div class="kraft" style="position:relative;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Posts prêts à publier</p></div></div>
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;margin-left:40px;transform:rotate(2deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div style="position:relative;padding:16px 30px 16px 52px;background:#F3E9B5;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Rapport mensuel chiffré</p></div></div>
      </div>
    </div>
  </div>
</section>

<!-- 4. DÉROULÉ -->
<section class="grid-cream s-deroule" style="position:relative;padding:116px 0 124px;color:#4A2018">
  <div class="wrap">
    <div class="s-deroule-head" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;margin-bottom:64px">
      <p class="label" style="color:#4A2018">— Le déroulé</p>
      <div style="position:relative">
        <h2 class="h2" style="color:#4A2018">Comment ça se passe</h2>
        <svg data-anim="draw" style="position:absolute;left:0;bottom:-16px;width:100%;height:18px" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C60 6 120 20 180 10 S270 8 296 12" fill="none" stroke="#C9A43A" stroke-width="5" stroke-linecap="round"></path></svg>
      </div>
    </div>
    <div style="position:relative">
      <svg class="s-dash d-only" data-anim="draw" style="position:absolute;left:4%;right:4%;top:34px;width:92%;height:6px" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><path d="M0 3 H100" stroke="rgba(74,32,24,.5)" stroke-width="2" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"></path></svg>
      <ol class="s-steps" data-stagger="180ms" style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:22px;color:#4A2018">
        <li class="bristol step" data-anim="land" style="transform:rotate(-2deg)"><span class="step-n">1</span><h3 class="h3" style="font-size:22px">Échange</h3><p class="small" style="font-size:15px">On parle de vous et de vos objectifs.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(1.5deg);margin-top:20px"><span class="step-n">2</span><h3 class="h3" style="font-size:22px">Audit express</h3><p class="small" style="font-size:15px">J'analyse vos réseaux actuels et ceux de vos concurrents.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(-1deg)"><span class="step-n">3</span><h3 class="h3" style="font-size:22px">Stratégie</h3><p class="small" style="font-size:15px">Je vous présente la ligne éditoriale et le calendrier.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(2deg);margin-top:20px"><span class="step-n">4</span><h3 class="h3" style="font-size:22px">Création et publication</h3><p class="small" style="font-size:15px">Je produis, vous validez chaque publication, je publie.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(-1.5deg)"><span class="step-n">5</span><h3 class="h3" style="font-size:22px">Bilan mensuel</h3><p class="small" style="font-size:15px">Vous recevez un reporting chaque mois, et on ajuste.</p></li>
      </ol>
    </div>
  </div>
</section>

<!-- 6. PROJETS LIÉS -->
<section id="projets" class="grid-brown dark s-projets" style="position:relative;padding:110px 0 120px;color:#F7F0DC">
  <div class="wrap">
    <div class="s-projets-head" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label" style="color:#F3E9B5">— Des résultats concrets</p>
        <h2 class="h2" style="color:#F7F0DC">Ils m'ont confié leurs réseaux</h2>
      </div>
      <a class="link s-allpf" href="/portfolio/" style="color:#F3E9B5">Tout le portfolio →</a>
    </div>
    <div class="s-proj-track" data-carousel data-stagger="220ms" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:56px;align-items:start;color:#4A2018">
      <article class="s-proj" data-anim="drop">
        <div class="polaroid" style="transform:rotate(-3deg);padding:14px 14px 58px">
          <div class="washi washi-dots" style="width:112px;top:-15px;left:50%;margin-left:-56px;transform:rotate(-5deg)"></div>
          <Img src="projet-salon-peches.jpg" alt="Projet Salon des Pêches" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover" />
          <p class="polaroid-cap" style="font-size:25px">Salon des Pêches</p>
        </div>
        <div class="kraft" style="position:relative;z-index:2;margin:-4px 14px 0 38px;padding:18px 20px;transform:rotate(1.5deg);box-shadow:0 10px 18px rgba(0,0,0,.3);display:flex;flex-direction:column;gap:8px">
          <a class="link" href="/portfolio/salon-des-peches/" data-projet="salon-des-peches" data-onglet="cm" style="font-size:12px">Voir le projet →</a>
        </div>
      </article>
      <article class="s-proj" data-anim="drop" style="margin-top:50px">
        <div class="polaroid" style="transform:rotate(2deg);padding:14px 14px 58px">
          <div class="washi washi-plain" style="width:112px;top:-14px;left:28px;transform:rotate(-8deg)"></div>
          <Img src="pf-fitadium.jpg" alt="Projet Fitadium" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover" />
          <p class="polaroid-cap" style="font-size:25px">Fitadium</p>
        </div>
        <div class="kraft" style="position:relative;z-index:2;margin:-4px 30px 0 20px;padding:18px 20px;transform:rotate(-2deg);box-shadow:0 10px 18px rgba(0,0,0,.3);display:flex;flex-direction:column;gap:8px">
          <a class="link" href="/portfolio/fitadium/" data-projet="fitadium" data-onglet="cm" style="font-size:12px">Voir le projet →</a>
        </div>
      </article>
      <article class="s-proj" data-anim="drop" style="margin-top:10px">
