      <details class="bristol faq" style="transform:rotate(.6deg)">
        <summary><span class="h3" style="font-size:21px">Travaillez-vous uniquement autour d'Angers ?</span><svg class="plus" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M11 3 V19 M3 11 H19" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round"></path></svg></summary>
