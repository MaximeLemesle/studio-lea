---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import '../../styles/service.css';
import '../../styles/pages/service-ugc.css';
---

<Base title="Studio Béa — UGC" active="services">
<!-- 1. ACCROCHE -->
<section class="grid-brown dark s-hero" style="position:relative;padding:76px 0 116px;color:#F7F0DC">
  <div class="wrap s-hero-grid" style="display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:64px;align-items:center">
    <div class="s-hero-text" style="position:relative;display:flex;flex-direction:column;gap:20px">
      <nav class="crumb" aria-label="Fil d'Ariane" style="color:#F3E9B5"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><a href="/services/" style="color:#F3E9B5">Services</a><span aria-hidden="true">/</span><span>UGC</span></nav>
      <span class="label dots" style="align-self:flex-start;padding:8px 16px;border-radius:10px 10px 0 0;background-color:#F4D3B8;color:#4A2018;font-size:12px">Dossier 05</span>
      <div style="position:relative;margin-top:-12px">
        <h1 class="h1 s-h1" style="font-size:68px;color:#F7F0DC">UGC</h1>
        <span class="script s-accroche s-accroche-abs" data-anim="write" aria-hidden="true" style="position:absolute;left:190px;top:8px;font-size:62px;color:#F3E9B5;transform:rotate(-6deg);white-space:nowrap">du contenu authentique</span>
      </div>
      <p class="lead s-lead" style="max-width:600px;color:#F7F0DC">Je prête mon image pour mettre en avant votre produit ou votre marque, dans des vidéos spontanées : face cam et/ou voix off, montage compris, au format de votre choix.</p>
      <div class="s-hero-cta" data-m-stack style="display:flex;flex-wrap:wrap;gap:18px;margin-top:8px">
        <a class="btn btn-primary on-dark" href="/contact/">Recevoir mon devis sous 24 h</a>
      </div>
    </div>
    <div class="s-hero-visual" style="position:relative;height:520px">
      <div class="polaroid s-pol1" data-anim="drop" style="--d:200ms;position:absolute;left:-10px;top:20px;width:200px;transform:rotate(-5deg)">
        <Img src="ugc-salon-peches.jpg" alt="Vidéo UGC face cam pour le Salon des Pêches" style="display:block;width:100%;aspect-ratio:9/16;object-fit:cover;object-position:top" />
        <p class="polaroid-cap">face cam</p>
      </div>
      <div class="polaroid s-pol2" data-anim="drop" style="--d:550ms;position:absolute;right:-30px;top:120px;width:180px;transform:rotate(5deg)">
        <div class="washi washi-dots" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-4deg)"></div>
        <Img src="ugc-nutraclear.jpg" alt="Vidéo UGC Nutraclear : Léa présente les compléments" style="display:block;width:100%;aspect-ratio:9/16;object-fit:cover" />
        <p class="polaroid-cap">en situation</p>
      </div>
      <div class="s-price" data-anim="swing" style="--d:1.1s;position:absolute;left:60px;bottom:-30px;transform:rotate(-6deg);filter:drop-shadow(3px 5px 0 rgba(0,0,0,.25))">
        <div class="kraft" style="position:relative;padding:14px 28px 14px 48px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%);color:#4A2018;display:flex;flex-direction:column">
          <span class="tag-hole" style="left:15px"></span>
          <span class="spec" style="font-weight:700">à partir de</span>
          <span class="serif" style="font-size:30px;line-height:1.1">100 € / vidéo</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. POUR QUI -->
<section class="grid-sage s-pourqui" style="position:relative;padding:110px 0 120px">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px 48px;margin-bottom:56px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Pour qui ?</p>
        <h2 class="h2">C'est pour vous si…</h2>
      </div>
    </div>
    <div class="s-postits" data-stagger="200ms" style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:40px">
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(-2deg);display:flex;flex-direction:column;gap:12px">
        <div class="washi washi-dots" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-3deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">1.</p>
        <p class="h3" style="font-size:24px">Vous voulez montrer votre produit en situation.</p>
        <p class="small">Une vraie personne qui l'utilise, ça parle plus qu'une photo catalogue.</p>
      </div>
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(1.5deg);display:flex;flex-direction:column;gap:12px;background-color:#F4D3B8">
        <div class="washi washi-plain" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(3deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">2.</p>
        <p class="h3" style="font-size:24px">Il vous faut des vidéos pour vos publicités.</p>
        <p class="small">Les droits sont cédés pour 12 mois : vous pouvez les utiliser en publicité payante et en organique.</p>
      </div>
      <div class="postit" data-anim="stick" style="position:relative;padding:44px 30px 32px;transform:rotate(-1deg);display:flex;flex-direction:column;gap:12px">
        <div class="washi washi-floral" style="width:100px;top:-14px;left:50%;margin-left:-50px;transform:rotate(-2deg)"></div>
        <p class="note" style="font-size:40px;line-height:1">3.</p>
        <p class="h3" style="font-size:24px">Vous n'avez pas envie de vous filmer.</p>
        <p class="small">Je me mets devant la caméra à votre place.</p>
      </div>
    </div>
    <div class="s-bonne" style="margin-top:96px;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:18px 28px;text-align:center">
      <p class="script" style="font-size:58px;line-height:1">Bonne nouvelle :</p>
      <p class="h3" style="font-size:26px;max-width:560px;text-align:left">je me filme pour vous et je montre votre produit en vrai.</p>
      <a class="btn btn-primary" href="/contact/">On en parle</a>
    </div>
  </div>
</section>

<!-- 5. FORMULES -->
<section class="grid-cream s-formules" style="position:relative;padding:120px 0 116px">
  <div class="wrap">
    <div style="position:relative;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px 48px;margin-bottom:60px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Tarifs</p>
        <h2 class="h2">Les formules</h2>
        <p class="script s-sur" data-anim="write" aria-hidden="true" style="font-size:66px;margin:-10px 0 0 230px;transform:rotate(-5deg)">ou sur-mesure</p>
      </div>
    </div>

    <div class="s-formules-grid" data-stagger="220ms" style="position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;align-items:stretch">
      <article class="formule lined shadow" data-anim="land" style="transform:rotate(-1.2deg)">
        <div class="washi washi-plain" style="width:110px;top:-15px;left:30px;transform:rotate(-5deg)"></div>
        <p class="label">Formule 1</p>
        <h3 class="h3">Le pack 1 vidéo</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div class="kraft"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">100 € <span style="font-size:20px">/ vidéo</span></span></div></div>
        <ul class="mini">
          <li>1 vidéo UGC</li>
          <li>2 révisions incluses</li>
          <li>Livrée en 7 jours</li>
          <li>Montage</li>
          <li>Voix off et/ou face cam</li>
        </ul>
        <p class="note" style="font-size:20px;margin-top:auto">Pour tester le format UGC.</p>
        <a class="btn btn-secondary" href="/contact/" style="align-self:flex-start">Choisir cette formule</a>
      </article>

      <article class="formule lined" data-anim="land" style="transform:rotate(.8deg);box-shadow:0 0 0 3px #4A2018,0 18px 34px rgba(40,15,10,.22)">
        <div class="washi washi-dots" style="width:110px;top:-15px;left:50%;margin-left:-55px;transform:rotate(3deg)"></div>
        <div class="sticker s-conseil" data-anim="sticker" style="--d:1.2s;position:absolute;right:-28px;top:-30px;width:132px;height:74px;transform:rotate(10deg)">
          <svg width="132" height="74" viewBox="-6 -6 212 122" aria-hidden="true"><path d="M50 95 C22 95 10 78 16 62 C4 52 14 30 34 34 C38 14 62 8 76 22 C86 4 120 4 128 24 C146 12 172 22 168 44 C190 48 192 78 170 86 C168 98 150 102 140 96 C126 106 100 106 90 98 C78 106 58 104 50 95 Z" fill="#FFFDF6" stroke="#FFFDF6" stroke-width="12" stroke-linejoin="round"></path><path d="M50 95 C22 95 10 78 16 62 C4 52 14 30 34 34 C38 14 62 8 76 22 C86 4 120 4 128 24 C146 12 172 22 168 44 C190 48 192 78 170 86 C168 98 150 102 140 96 C126 106 100 106 90 98 C78 106 58 104 50 95 Z" fill="#EFC9D2" stroke="#4A2018" stroke-width="1.6"></path></svg>
          <span class="note" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;padding-top:4px">mon conseil</span>
        </div>
        <p class="label">Formule 2</p>
        <h3 class="h3">Le pack 3 vidéos</h3>
        <div class="price-tag" data-anim="swing" style="--d:.6s"><div style="background:#F3E9B5"><span class="tag-hole" style="left:15px"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:34px;line-height:1.1">250 €</span></div></div>
        <ul class="mini">
          <li>Tout le pack 1 vidéo, en plus grande quantité pour vos campagnes</li>
        </ul>
        <a class="btn btn-primary" href="/contact/" style="align-self:flex-start">Choisir cette formule</a>
      </article>

      <article class="formule postit" data-anim="land" style="transform:rotate(-.6deg);outline:2px dashed rgba(74,32,24,.45);outline-offset:-12px">
        <div class="washi washi-floral" style="width:110px;top:-15px;right:30px;transform:rotate(6deg)"></div>
        <p class="label">Sur-mesure</p>
        <p class="script" style="font-size:64px;line-height:.9;margin:4px 0 2px">votre formule</p>
        <p class="small">Une campagne avec plusieurs produits, des déclinaisons pour la publicité, un mélange avec le community management… On construit votre formule ensemble, à partir de vos besoins et de votre budget.</p>
        <div style="margin-top:auto;padding-top:8px"><a class="btn btn-primary" href="/contact/">Parlons-en</a></div>
      </article>
    </div>

    <div style="margin-top:96px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 14px">
      <p class="label" style="margin-right:6px">Dans toutes les formules</p>
      <span class="chip-incl">Format au choix</span>
      <span class="chip-incl">Droits cédés pour 12 mois</span>
      <span class="chip-incl">Diffusion en publicité payante et en organique</span>
      <span class="chip-incl">Produit envoyé à vos frais</span>
    </div>
  </div>
</section>

<!-- 3. INCLUS + LIVRABLES -->
<section class="grid-sage s-inclus" style="position:relative;padding:120px 0">
  <div class="wrap s-inclus-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(460px,100%),1fr));gap:64px;align-items:start">
    <div style="position:relative">
    <div class="lined shadow s-inclus-card" style="position:relative;padding:48px 48px 40px;transform:rotate(-1deg)">
      <div class="washi washi-plain" style="width:120px;top:-15px;left:40px;transform:rotate(-6deg)"></div>
      <p class="label">Le contenu du dossier</p>
      <h2 class="h2" style="font-size:40px;margin:8px 0 22px">Ce qui est inclus</h2>
      <ul class="check" data-stagger="160ms">
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F4D3B8" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Face cam et/ou voix off</b>, au choix.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F4D3B8" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Format</b> au choix, pour vos réseaux ou vos publicités.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F4D3B8" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Montage</b> compris.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F4D3B8" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Sous-titres</b> : avec ou sans, au choix.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F4D3B8" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Script</b> : le vôtre, ou je vous en propose un.</span></li>
        <li><svg data-anim="draw" width="30" height="30" viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="13" fill="#F4D3B8" stroke="#4A2018" stroke-width="1.5"></circle><path d="M9 15.5 L13.5 20 L21.5 10.5" fill="none" stroke="#4A2018" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b>Droits cédés pour 12 mois</b>, en publicité payante et en organique.</span></li>
      </ul>
    </div>
    </div>

    <div style="position:relative;display:flex;flex-direction:column;gap:14px;padding-top:12px">
      <p class="label">Ce que vous recevez</p>
      <h2 class="h2" style="font-size:40px;margin-bottom:22px">Les livrables</h2>
      <div class="s-ltags" data-stagger="180ms" style="display:flex;flex-direction:column;gap:20px">
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;transform:rotate(-2deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div class="kraft" style="position:relative;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Vidéo montée, au format de votre choix</p></div></div>
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;margin-left:40px;transform:rotate(1.5deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div style="position:relative;background:#F3E9B5;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Version avec ou sans sous-titres</p></div></div>
        <div class="s-ltag" data-anim="swing" style="align-self:flex-start;transform:rotate(-1deg);filter:drop-shadow(3px 5px 0 rgba(74,32,24,.18))"><div class="kraft" style="position:relative;padding:16px 30px 16px 52px;clip-path:polygon(26px 0,100% 0,100% 100%,26px 100%,0 50%)"><span class="tag-hole" style="left:16px"></span><p class="h3" style="font-size:22px">Droits cédés pour 12 mois</p></div></div>
      </div>
      <p class="note" style="margin-top:10px">Le produit est à m'envoyer, à vos frais (retour compris).</p>
    </div>
  </div>
</section>

<!-- 4. DÉROULÉ -->
<section class="grid-cream s-deroule" style="position:relative;padding:116px 0 124px;color:#4A2018">
  <div class="wrap">
    <div class="s-deroule-head" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:14px;margin-bottom:64px">
      <p class="label" style="color:#4A2018">— Le déroulé</p>
      <div style="position:relative">
        <h2 class="h2" style="color:#4A2018">Comment ça se passe</h2>
        <svg data-anim="draw" style="position:absolute;left:0;bottom:-16px;width:100%;height:18px" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16 C60 6 120 20 180 10 S270 8 296 12" fill="none" stroke="#C9A43A" stroke-width="5" stroke-linecap="round"></path></svg>
      </div>
    </div>
    <div style="position:relative">
      <svg class="s-dash d-only" data-anim="draw" style="position:absolute;left:4%;right:4%;top:34px;width:92%;height:6px" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true"><path d="M0 3 H100" stroke="rgba(74,32,24,.5)" stroke-width="2" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"></path></svg>
      <ol class="s-steps" data-stagger="180ms" style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:22px;color:#4A2018">
        <li class="bristol step" data-anim="land" style="transform:rotate(-2deg)"><span class="step-n">1</span><h3 class="h3" style="font-size:22px">Échange</h3><p class="small" style="font-size:15px">On parle de vous et de vos objectifs.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(1.5deg);margin-top:20px"><span class="step-n">2</span><h3 class="h3" style="font-size:22px">Brief et script</h3><p class="small" style="font-size:15px">Vous avez une idée ? Sinon, je vous propose un script et on le valide ensemble.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(-1deg)"><span class="step-n">3</span><h3 class="h3" style="font-size:22px">Envoi du produit</h3><p class="small" style="font-size:15px">Vous m'envoyez le produit s'il y en a un, à vos frais.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(2deg);margin-top:20px"><span class="step-n">4</span><h3 class="h3" style="font-size:22px">Tournage et montage</h3><p class="small" style="font-size:15px">Face cam et/ou voix off, puis montage.</p></li>
        <li class="bristol step" data-anim="land" style="transform:rotate(-1.5deg)"><span class="step-n">5</span><h3 class="h3" style="font-size:22px">Livraison</h3><p class="small" style="font-size:15px">Votre vidéo sous 7 jours, avec 2 révisions incluses et ses droits pour 12 mois.</p></li>
      </ol>
    </div>
  </div>
</section>

<!-- 6. PROJETS LIÉS -->
<section id="projets" class="grid-brown dark s-projets" style="position:relative;padding:110px 0 120px;color:#F7F0DC">
  <div class="wrap">
    <div class="s-projets-head" style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label" style="color:#F3E9B5">— Projets liés</p>
        <h2 class="h2" style="color:#F7F0DC">Mes dernières vidéos</h2>
      </div>
      <a class="link s-allpf" href="/portfolio/" style="color:#F3E9B5">Tout le portfolio →</a>
    </div>
    <div class="s-proj-track" data-carousel data-stagger="220ms" style="position:relative;display:grid;grid-template-columns:repeat(2,minmax(0,280px));justify-content:center;gap:56px;align-items:start;color:#4A2018">
      <article class="s-proj" data-anim="drop" style="max-width:270px;width:100%;justify-self:center">
        <a href="/portfolio/salon-des-peches/" data-projet="salon-des-peches" aria-label="Voir le projet Salon des Pêches en grand" style="display:block;text-decoration:none;color:inherit">
        <div class="polaroid" style="transform:rotate(-3deg);padding:14px 14px 58px">
          <div class="washi washi-dots" style="width:112px;top:-15px;left:50%;margin-left:-56px;transform:rotate(-5deg)"></div>
          <Img src="ugc-salon-peches.jpg" alt="Vidéo UGC face cam pour le Salon des Pêches" style="display:block;width:100%;aspect-ratio:9/16;object-fit:cover;object-position:top" />
          <p class="polaroid-cap" style="font-size:25px">Salon des Pêches</p>
        </div>
        </a>
      </article>
      <article class="s-proj" data-anim="drop" style="margin-top:50px;max-width:270px;width:100%;justify-self:center">
        <a href="/portfolio/nutraclear/" data-projet="nutraclear" aria-label="Voir le projet Nutraclear en grand" style="display:block;text-decoration:none;color:inherit">
        <div class="polaroid" style="transform:rotate(2deg);padding:14px 14px 58px">
          <div class="washi washi-plain" style="width:112px;top:-14px;left:28px;transform:rotate(-8deg)"></div>
          <Img src="ugc-nutraclear.jpg" alt="Vidéo UGC Nutraclear : Léa présente les compléments" style="display:block;width:100%;aspect-ratio:9/16;object-fit:cover" />
          <p class="polaroid-cap" style="font-size:25px">Nutraclear</p>
        </div>
        </a>
      </article>
    </div>
    <div class="pager m-only" data-pager aria-hidden="true"><span></span><span></span></div>
    <a class="link s-allpf m-only" href="/portfolio/" style="color:#F3E9B5">Tout le portfolio →</a>
  </div>
</section>

<!-- TÉMOIGNAGE -->
<section class="grid-cream s-temoin" style="position:relative;padding:110px 0 110px">
  <div class="wrap" style="display:flex;flex-direction:column;align-items:center;gap:30px">
    <div style="display:flex;flex-direction:column;align-items:center;gap:8px">
      <p class="label">— Ils en parlent</p>
      <h2 class="h2">Le mot de mes clients</h2>
    </div>
