<script>
  // Pastilles = ancres (A9) : défilement doux jusqu'au dossier, qui s'ouvre (sur mobile, accordéon).
  document.querySelectorAll<HTMLAnchorElement>('.sv-pills a').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (!window.matchMedia('(max-width: 720px)').matches) return;
      const key = a.hash.slice(1);
      const d = document.getElementById(`m-${key}`) as HTMLDetailsElement | null;
      if (!d) return;
      e.preventDefault();
      d.open = true;
      d.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });
  });
</script>
