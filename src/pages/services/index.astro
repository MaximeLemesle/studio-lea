            <div style="align-self:flex-start;filter:drop-shadow(3px 4px 0 rgba(74,32,24,.18));transform:rotate(-2deg);margin:4px 0 6px"><div class="ptag kraft"><span class="tag-hole"></span><span class="spec" style="font-weight:700">à partir de</span><span class="serif" style="font-size:22px;line-height:1.1">30 €</span></div></div>
