---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import '../styles/service.css';
import '../styles/pages/apropos.css';
---

<Base title="Studio Béa — À propos" active="a-propos">
<!-- 1. HERO -->
<section class="grid-brown dark ap-hero" style="position:relative;padding:76px 0 120px;color:#F7F0DC">
  <div class="wrap ap-hero-grid" style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:64px;align-items:center">
    <div class="ap-hero-text" style="position:relative;display:flex;flex-direction:column;gap:20px">
      <nav class="crumb" aria-label="Fil d'Ariane" style="color:#F3E9B5"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><span>À propos</span></nav>
      <span class="label dots" style="align-self:flex-start;padding:8px 16px;border-radius:10px 10px 0 0;background-color:#CFE3C4;color:#4A2018;font-size:12px">Carnet perso</span>
      <h1 class="h1 ap-h1" style="color:#F7F0DC;margin-top:-12px">À propos</h1>
      <p class="script ap-enchantee" data-anim="write" aria-hidden="true" style="--d:.4s;font-size:70px;color:#F3E9B5;margin:-18px 0 0 150px;transform:rotate(-5deg)">enchantée, moi c'est Léa</p>
      <p class="lead" style="max-width:600px;color:#F7F0DC">Freelance en communication depuis 2 ans, je suis basée à Angers et je travaille en français comme en anglais.</p>
      <div class="ap-hero-cta" data-m-stack style="display:flex;flex-wrap:wrap;gap:18px;margin-top:8px">
        <a class="btn btn-primary on-dark" href="/contact/">Travaillons ensemble</a>
        <a class="btn btn-secondary on-dark" href="#parcours">Voir mon parcours</a>
      </div>
    </div>
    <div class="ap-visual" style="position:relative;height:540px">
      <div class="polaroid ap-pol" data-anim="drop" style="--d:.3s;position:absolute;left:30px;top:10px;width:330px;transform:rotate(-4deg)">
        <div class="washi washi-floral" style="width:120px;top:-15px;left:50%;margin-left:-60px;transform:rotate(-3deg)"></div>
        <Img src="lea-audouin-v2.jpg" alt="Léa Audouin, micro à la main, au bord de la mer" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover" />
        <p class="polaroid-cap" style="font-size:26px">c'est moi !</p>
      </div>
    </div>
  </div>
</section>

<!-- 2. CHIFFRES CLÉS -->
<section class="grid-cream ap-kpis-sec" style="position:relative;padding:96px 0 96px">
  <div class="wrap">
    <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:44px">
      <p class="label">— En bref</p>
      <h2 class="h2">Quelques repères</h2>
    </div>
    <div class="ap-kpis" data-stagger="160ms" style="position:relative;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px">
      <div class="kpi" data-anim="stick" style="transform:rotate(-1.5deg)"><div class="washi washi-plain" style="width:90px;top:-14px;left:24px;transform:rotate(-6deg)"></div><span class="big">Bac +5</span><p class="small">Master Content Marketing et Brand Entertainment</p></div>
      <div class="kpi" data-anim="stick" style="transform:rotate(1deg)"><div class="washi washi-dots" style="width:90px;top:-14px;left:50%;margin-left:-45px;transform:rotate(4deg)"></div><span class="big">2 ×</span><p class="small">major de promo, en bachelor puis en master</p></div>
      <div class="kpi" data-anim="stick" style="transform:rotate(-.8deg)"><div class="washi washi-floral" style="width:90px;top:-14px;right:24px;transform:rotate(5deg)"></div><span class="big">2 ans</span><p class="small">en freelance, sous le nom Studio Béa</p></div>
      <div class="kpi" data-anim="stick" style="transform:rotate(1.4deg)"><div class="washi washi-plain" style="width:90px;top:-14px;left:50%;margin-left:-45px;transform:rotate(-3deg)"></div><span class="big">FR · EN</span><p class="small">une communication en français et en anglais</p></div>
    </div>
  </div>
</section>

<!-- 3. PARCOURS -->
<section id="parcours" class="grid-sage ap-cv" style="position:relative;padding:110px 0 120px">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px 48px;margin-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Mon parcours</p>
        <h2 class="h2">Le CV</h2>
      </div>
    </div>

    <div style="position:relative">
      <p class="label" style="margin-bottom:26px">Formation</p>
      <div class="ap-diplomas" data-stagger="250ms" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:56px;align-items:start">
        <article class="diploma" data-anim="land" style="transform:rotate(-1.2deg)">
          <div class="seal" data-anim="stamp" style="--d:.6s"><span>Major</span><b>de promo</b></div>
          <p class="label" style="font-size:11px;color:#6B4A3E">Master · Bac +5</p>
          <h3 class="h3">Content Marketing et Brand Entertainment</h3>
          <p class="small">Ynov Campus · Sophia Antipolis · 2024 – 2026</p>
        </article>
        <article class="diploma" data-anim="land" style="transform:rotate(1deg)">
          <div class="seal" data-anim="stamp" style="--d:.6s;transform:rotate(-8deg)"><span>Major</span><b>de promo</b></div>
          <p class="label" style="font-size:11px;color:#6B4A3E">Bachelor · Bac +3</p>
          <h3 class="h3">Webmarketing et Social Media</h3>
          <p class="small">MyDigitalSchool · Angers · 2021 – 2024</p>
        </article>
      </div>
    </div>
  </div>
</section>

<!-- 4. UNIVERS -->
<section class="grid-brown dark ap-univ" style="position:relative;padding:90px 0 96px;color:#F7F0DC">
  <div class="wrap" style="display:flex;flex-direction:column;gap:30px">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:10px 28px">
      <h2 class="h2 ap-univ-title" style="color:#F7F0DC;font-size:44px">J'ai déjà raconté…</h2>
      <p class="script ap-bref" data-anim="write" aria-hidden="true" style="font-size:56px;color:#F3E9B5;transform:rotate(-4deg)">bref, je m'adapte !</p>
    </div>
    <div class="ap-univs" data-stagger="90ms" style="display:flex;flex-wrap:wrap;gap:14px">
      <span class="univ" data-anim="land" style="background:#C9D6EC">Une mairie</span>
      <span class="univ" data-anim="land" style="background:#CFE3C4">Une communauté de communes</span>
      <span class="univ" data-anim="land" style="background:#EFC9D2">De l'événementiel</span>
      <span class="univ" data-anim="land" style="background:#F2E3A0">Du BtoB</span>
      <span class="univ" data-anim="land" style="background:#C9D6EC">Du BtoC</span>
      <span class="univ" data-anim="land" style="background:#CFE3C4">Du sport</span>
      <span class="univ" data-anim="land">Du parfum</span>
      <span class="univ" data-anim="land" style="background:#F4D3B8">De la pêche</span>
      <span class="univ" data-anim="land" style="background:#DCD6A9">De l'agriculture</span>
      <span class="univ" data-anim="land" style="background:#F3E9B5">De la nutrition santé</span>
    </div>
  </div>
</section>

<!-- 5. HORS CV -->
<section class="grid-cream ap-fun-sec" style="position:relative;padding:110px 0 120px">
  <div class="wrap">
    <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px 48px;margin-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:10px">
        <p class="label">— Hors CV</p>
        <h2 class="h2">Ce qu'on ne lit pas sur mon CV</h2>
        <p class="script ap-petits" data-anim="write" aria-hidden="true" style="font-size:60px;margin:-12px 0 0 420px;transform:rotate(-4deg)">les petits plus</p>
      </div>
    </div>
    <div class="ap-funs" data-stagger="220ms" style="position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;max-width:1040px;margin:0 auto;align-items:start">
      <div class="fun hover-straight m-tap-peel" data-anim="stick" style="background:#C9D6EC;transform:rotate(-2.5deg)">
        <div class="washi washi-dots" style="width:96px;top:-14px;left:50%;margin-left:-48px;transform:rotate(-4deg)"></div>
        <svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><circle cx="23" cy="23" r="19" fill="#1D4E9E"></circle><circle cx="17" cy="17" r="5" fill="#FFFFFF" opacity=".35"></circle></svg>
        <p class="h3" style="font-size:24px">J'aime le bleu.</p>
        <p class="small">Le bleu de l'océan, celui du ciel… c'est ma couleur.</p>
      </div>
      <div class="fun hover-straight m-tap-peel" data-anim="stick" style="background:#EFC9D2;transform:rotate(1.8deg);margin-top:30px">
        <div class="washi washi-plain" style="width:96px;top:-14px;left:30px;transform:rotate(-7deg)"></div>
        <svg width="46" height="46" viewBox="0 0 46 46" aria-hidden="true"><rect x="10" y="5" width="26" height="6" rx="2" fill="#4A2018"></rect><rect x="10" y="35" width="26" height="6" rx="2" fill="#4A2018"></rect><rect x="14" y="11" width="18" height="24" fill="#F3E9B5" stroke="#4A2018" stroke-width="2"></rect><path d="M14 16 L32 20 M14 22 L32 26 M14 28 L32 32" stroke="#4A2018" stroke-width="1.4"></path><path d="M32 31 C40 33 42 38 37 43" fill="none" stroke="#4A2018" stroke-width="1.6" stroke-linecap="round"></path></svg>
        <p class="h3" style="font-size:24px">Vive le fait maison !</p>
        <p class="small">Couture, albums photo, cuisine…</p>
      </div>
      <div class="fun hover-straight m-tap-peel" data-anim="stick" style="background:#CFE3C4;transform:rotate(-1deg)">
        <div class="washi washi-floral" style="width:96px;top:-14px;right:26px;transform:rotate(5deg)"></div>
        <svg width="48" height="44" viewBox="0 0 48 44" aria-hidden="true"><ellipse cx="24" cy="30" rx="11" ry="9" fill="#4A2018"></ellipse><ellipse cx="9" cy="18" rx="5" ry="6.5" fill="#4A2018"></ellipse><ellipse cx="18" cy="9" rx="5" ry="6.5" fill="#4A2018"></ellipse><ellipse cx="30" cy="9" rx="5" ry="6.5" fill="#4A2018"></ellipse><ellipse cx="39" cy="18" rx="5" ry="6.5" fill="#4A2018"></ellipse></svg>
        <p class="h3" style="font-size:24px">Mon rêve : ouvrir un refuge pour animaux.</p>
        <p class="small">Fun fact : j'ai été bénévole dans une association pour chats.</p>
      </div>
    </div>
    <div class="ap-more" style="margin-top:110px;display:flex;justify-content:center">
      <div style="position:relative;padding:24px 34px;outline:2px dashed rgba(74,32,24,.45);outline-offset:-8px;background:#FFFDF6;transform:rotate(-1deg);max-width:620px;text-align:center">
        <p class="note" style="font-size:26px"><span class="a-completer">À compléter</span></p>
      </div>
    </div>
  </div>
</section>

<!-- 6. CTA -->
<section class="grid-sage ap-cta s-cta" style="position:relative;padding:110px 0 130px">
  <div class="wrap" style="display:flex;justify-content:center">
    <div style="position:relative;width:100%;max-width:860px">
      <div class="lined s-letter" style="position:relative;padding:60px 60px 50px;transform:rotate(-1deg);box-shadow:0 22px 40px rgba(40,15,10,.25);text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px">
        <div class="washi washi-dots" style="width:130px;top:-14px;left:-26px;transform:rotate(-30deg)"></div>
        <h2 style="margin:0;display:flex;flex-direction:column;align-items:center;font-weight:400">
          <span class="h1 s-cta-title" style="display:block;font-size:48px">On fait connaissance ?</span>
          <span class="script s-cta-script" data-anim="write" style="display:block;font-size:96px;line-height:1.1">Écrivez-moi</span>
        </h2>
        <p class="lead s-cta-lead" style="max-width:560px">Parlez-moi de votre activité : je vous réponds sous 24 h avec une première piste.</p>
        <div data-m-stack style="display:flex;flex-wrap:wrap;justify-content:center;gap:18px;margin-top:6px">
          <a class="btn btn-primary" href="/contact/">Me contacter</a>
          <a class="btn btn-secondary" href="/services/">Voir les services</a>
        </div>
      </div>
    </div>
  </div>
</section>
</Base>
