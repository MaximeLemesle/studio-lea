---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import '../styles/pages/contact.css';
---

<Base title="Contact · Studio Béa" description="Un projet, une question ? Écrivez-moi, je vous réponds rapidement.">
<!-- INTRO -->
<section class="grid-brown dark ct-hero" style="position:relative;padding:72px 0 150px;color:#F7F0DC">
  <div class="wrap" style="position:relative;display:flex;flex-direction:column;gap:18px">
    <nav class="crumb" aria-label="Fil d'Ariane" style="color:#F3E9B5"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><span>Contact</span></nav>
    <h1 class="h1 ct-h1" style="color:#F7F0DC">Un projet <br class="m-only" />en tête ?</h1>
    <p class="script ct-ecrivez" data-anim="write" aria-hidden="true" style="--d:.4s;font-size:80px;color:#F3E9B5;margin:-26px 0 0 480px;transform:rotate(-5deg)">écrivez-moi</p>
    <p class="lead ct-lead" style="max-width:640px;color:#F7F0DC;margin-top:16px"><span class="d-only">Prenez votre plus belle plume (ou votre clavier) : racontez-moi votre activité et vos envies. Je vous réponds avec une première piste.</span><span class="m-only">Racontez-moi votre activité et vos envies : je vous réponds avec une première piste.</span></p>
    <svg class="ct-star twinkle" style="position:absolute;right:30px;top:90px;transform:rotate(12deg)" width="120" height="120" viewBox="0 0 24 24" aria-hidden="true"><defs><pattern id="pdCt" width="1.6" height="1.6" patternUnits="userSpaceOnUse"><circle cx=".8" cy=".8" r=".38" fill="#4A2018"></circle></pattern></defs><path d="M12 1.6l2.9 6.5 7.1.8-5.3 4.8 1.5 7-6.2-3.6-6.2 3.6 1.5-7L2 8.9l7.1-.8z" fill="#FFFDF6" stroke="#4A2018" stroke-width=".3" stroke-linejoin="round"></path><path d="M12 1.6l2.9 6.5 7.1.8-5.3 4.8 1.5 7-6.2-3.6-6.2 3.6 1.5-7L2 8.9l7.1-.8z" fill="url(#pdCt)"></path></svg>
  </div>
</section>

<!-- FORMULAIRE + INFOS -->
<section class="grid-sage ct-main" style="position:relative;padding:0 0 120px">
  <div class="wrap ct-grid" style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,.85fr);gap:56px;align-items:start;margin-top:-90px">

    <!-- LETTRE -->
    <div class="ct-letter-wrap" style="position:relative" data-anim="rise">
      <form class="letter" id="contact-form" action="/api/contact.php" method="post" enctype="multipart/form-data" novalidate style="position:relative;padding:60px 56px 52px 100px;transform:rotate(-.6deg);box-shadow:0 24px 44px rgba(40,15,10,.28);display:flex;flex-direction:column;gap:26px" aria-label="Formulaire de contact">
        <div class="ct-hp" aria-hidden="true"><input type="text" name="site_web" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="t0" value="" />
        <div class="washi washi-dots" data-anim="tape" style="--d:.5s;width:140px;top:-15px;left:-30px;transform:rotate(-28deg)"></div>
        <div class="washi washi-dots" data-anim="tape" style="--d:.7s;width:140px;top:-15px;right:-30px;transform:rotate(28deg)"></div>
        <svg class="d-only" style="position:absolute;top:28px;right:34px;transform:rotate(-12deg);opacity:.85" width="104" height="104" viewBox="0 0 130 130" aria-hidden="true"><defs><path id="arcCt" d="M65 65 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0"></path></defs><circle cx="65" cy="65" r="61" fill="none" stroke="#4A2018" stroke-width="2.5"></circle><circle cx="65" cy="65" r="35" fill="none" stroke="#4A2018" stroke-width="1.5" stroke-dasharray="3 3"></circle><text font-family="'Courier Prime', monospace" font-size="10" font-weight="700" letter-spacing="1.2" fill="#4A2018"><textPath href="#arcCt">STUDIO BÉA · FAIT MAIN · ANGERS · 49 · </textPath></text><path transform="translate(53 53)" d="M12 1.6l2.9 6.5 7.1.8-5.3 4.8 1.5 7-6.2-3.6-6.2 3.6 1.5-7L2 8.9l7.1-.8z" fill="#4A2018"></path></svg>

        <p class="note" style="font-size:38px;line-height:1">Chère Léa,</p>

        <div class="ct-2col" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 32px">
          <div class="field"><label for="c-nom">Prénom et nom <span class="req">*</span></label><input id="c-nom" name="nom" type="text" placeholder="Camille Martin" autocomplete="name" required aria-describedby="c-nom-err"><p class="ct-err note" id="c-nom-err" hidden></p></div>
          <div class="field"><label for="c-mail">Email <span class="req">*</span></label><input id="c-mail" name="email" type="email" inputmode="email" placeholder="camille@exemple.fr" autocomplete="email" required aria-describedby="c-mail-err"><p class="ct-err note" id="c-mail-err" hidden></p></div>
          <div class="field" style="grid-column:1 / -1"><label for="c-ent">Entreprise / activité</label><input id="c-ent" name="entreprise" type="text" placeholder="ex. La Petite Boulangerie, Angers" autocomplete="organization"></div>
        </div>

        <div class="chips" data-formule hidden><input type="hidden" name="formule" value="" /></div>

        <fieldset data-sans-formule style="border:0;padding:0;margin:0;display:flex;flex-direction:column;gap:12px">
          <legend class="flabel" style="padding:0;margin-bottom:12px">Les dossiers qui vous intéressent</legend>
          <div class="chips">
            <label class="chip" style="background:#F2E3A0;transform:rotate(-1.5deg)"><input type="checkbox" name="services[]" value="Community management"> Community management</label>
            <label class="chip" style="background:#C9D6EC;transform:rotate(1deg)"><input type="checkbox" name="services[]" value="Audit stratégique"> <span class="d-only">Audit stratégique</span><span class="m-only">Audit</span></label>
            <label class="chip" style="background:#EFC9D2;transform:rotate(-1deg)"><input type="checkbox" name="services[]" value="Graphisme"> Graphisme</label>
            <label class="chip" style="background:#CFE3C4;transform:rotate(1.5deg)"><input type="checkbox" name="services[]" value="Rédactionnel"> Rédactionnel</label>
            <label class="chip" style="background:#F4D3B8;transform:rotate(-.5deg)"><input type="checkbox" name="services[]" value="UGC"> UGC</label>
          </div>
        </fieldset>

        <div class="ct-2col" data-sans-formule style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 32px">
          <fieldset style="border:0;padding:0;margin:0">
            <legend class="flabel" style="padding:0;margin-bottom:12px">Budget</legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="budget" value="50 – 500 €"> 50 – 500 €</label>
              <label class="chip"><input type="radio" name="budget" value="500 – 1 500 €"> 500 – 1 500 €</label>
              <label class="chip"><input type="radio" name="budget" value="1 500 € +"> 1 500 € +</label>
              <label class="chip"><input type="radio" name="budget" value="Je ne sais pas"> Je ne sais pas</label>
            </div>
          </fieldset>
          <fieldset style="border:0;padding:0;margin:0">
            <legend class="flabel" style="padding:0;margin-bottom:12px">Délai</legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="delai" value="Dès que possible"> Dès que possible</label>
              <label class="chip"><input type="radio" name="delai" value="Dans le mois"> Dans le mois</label>
              <label class="chip"><input type="radio" name="delai" value="D'ici 3 mois"> D'ici 3 mois</label>
              <label class="chip"><input type="radio" name="delai" value="Pas pressé"> Pas pressé</label>
            </div>
          </fieldset>
        </div>

        <div class="field"><label for="c-msg">Votre message <span class="req">*</span></label><textarea id="c-msg" name="message" rows="5" placeholder="Racontez-moi votre projet, vos envies, ce qui vous bloque…" required aria-describedby="c-msg-err"></textarea><p class="ct-err note" id="c-msg-err" hidden></p></div>

        <div class="field"><span class="flabel">Pièce jointe <span style="font-weight:400;letter-spacing:.06em;text-transform:none">(facultatif)</span></span><label for="c-file" class="ct-drop" data-drop style="display:flex;align-items:center;gap:14px;min-height:64px;margin-top:8px;padding:14px 20px;border:2px dashed rgba(74,32,24,.5);border-radius:10px;background:rgba(243,233,181,.45);cursor:pointer;font-family:'DM Sans Variable','DM Sans','Helvetica Neue',Arial,sans-serif;font-weight:400;font-size:17px;letter-spacing:0;text-transform:none;line-height:1.4"><svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true" style="flex:none"><path d="M16.5 6.5 L8.6 14.4 a2 2 0 0 0 2.8 2.8 L19 9.6 a4 4 0 0 0 -5.7 -5.7 L5.4 11.8 a6 6 0 0 0 8.5 8.5 L20 14.2" fill="none" stroke="#4A2018" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg><span><b style="font-weight:700">Ajouter un fichier</b><span class="d-only"> ou le glisser ici</span><br><span class="spec" style="font-size:13px">Votre charte graphique, vos inspirations… PDF, JPG ou PNG, 10 Mo max</span></span></label><input id="c-file" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="c-file-err" style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none"><ul class="ct-files" data-files aria-live="polite"></ul><p class="ct-err note" id="c-file-err" hidden></p></div>

        <div class="ct-rgpd"><label style="display:grid;grid-template-columns:22px minmax(0,1fr);gap:12px;align-items:start;font-size:15px;line-height:1.5;cursor:pointer"><input id="c-rgpd" name="rgpd" type="checkbox" value="oui" required aria-describedby="c-rgpd-err" style="accent-color:#4A2018;width:20px;height:20px;margin:2px 0 0"><span><span class="d-only">J'accepte que mes données soient utilisées pour répondre à ma demande, conformément à la <a href="/confidentialite/">politique de confidentialité</a>.</span><span class="m-only">J'accepte que mes données soient utilisées pour répondre à ma demande (<a href="/confidentialite/">politique de confidentialité</a>).</span> <span class="req">*</span></span></label><p class="ct-err note" id="c-rgpd-err" hidden></p></div>

        <div class="ct-sign" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:20px;margin-top:6px">
          <p class="note" style="font-size:28px"><span class="d-only">À très vite,<br><span style="font-size:22px">— signé : vous</span></span><span class="m-only">À très vite !</span></p>
          <button class="btn btn-primary" type="submit" data-submit>Envoyer ma lettre</button>
        </div>
        <p class="ct-err note" data-send-err role="alert" hidden></p>
        <p class="spec"><span class="req">*</span> champs obligatoires</p>
      </form>
    </div>

    <!-- COLONNE INFOS -->
    <!-- ENVOYÉE (A13, M16) -->
    <div class="ct-sent" data-sent hidden tabindex="-1">
      <div class="ct-envelope" aria-hidden="true"><span class="ct-flap"></span></div>
      <div class="ct-sent-card paper shadow">
        <p class="note" style="font-size:24px">Votre lettre est bien partie !</p>
        <p class="small" style="font-size:15px">Je vous réponds très vite.</p>
        <span class="label ct-stamp">Envoyée !</span>
      </div>
    </div>
    <aside class="ct-aside" data-stagger="220ms" style="position:relative;display:flex;flex-direction:column;gap:40px;padding-top:150px" aria-label="Autres moyens de me joindre">
      <p class="label m-only">Ou autrement…</p>
      <div class="ct-devis" data-anim="land" style="transform:rotate(-2deg);filter:drop-shadow(4px 6px 0 rgba(74,32,24,.2))">
        <div class="kraft" style="position:relative;padding:26px 28px 26px 58px;clip-path:polygon(30px 0,100% 0,100% 100%,30px 100%,0 50%);display:flex;flex-direction:column;gap:8px">
          <span class="tag-hole" style="left:18px"></span>
          <p class="label">Votre devis</p>
          <p class="serif" style="font-size:30px;line-height:1.1">Réponse sous 24 h</p>
          <p class="small" style="font-size:15px"><span class="d-only">Je lis chaque lettre avec attention et je reviens vers vous avec une première piste.</span><span class="m-only">Je reviens vers vous avec une première piste.</span></p>
        </div>
      </div>

      <div class="postit ct-follow" data-anim="stick" style="position:relative;padding:36px 30px 28px;transform:rotate(-2deg);display:flex;flex-direction:column;gap:10px">
        <div class="washi washi-plain" style="width:96px;top:-14px;left:50%;margin-left:-48px;transform:rotate(4deg)"></div>
        <p class="label">Me suivre</p>
        <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column">
          <li><a class="link" href="https://www.instagram.com/lesaleaas/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;min-height:44px">Instagram →</a></li>
          <li><a class="link" href="https://www.linkedin.com/in/l%C3%A9a-audouin/" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;min-height:44px">LinkedIn →</a></li>
        </ul>
        <p class="note" style="font-size:18px">@lesaleaas</p>
      </div>
    </aside>
  </div>
</section>

<script>
  import '../scripts/contact';
</script>
</Base>
