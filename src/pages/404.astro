---
// Page introuvable : pas de maquette. Textes à faire valider par Léa (voir README, « Prochaine étape »).
import Base from '../layouts/Base.astro';
import '../styles/service.css';
import '../styles/pages/contact.css';
---
<Base title="Studio Béa — 404">
  <section class="grid-brown dark" style="position:relative;padding:96px 0 140px;color:#F7F0DC">
    <div class="wrap" style="display:flex;flex-direction:column;gap:22px;align-items:flex-start">
      <p class="label" style="color:#F3E9B5">— 404</p>
      <h1 class="h1" style="color:#F7F0DC"><span class="a-completer">À compléter</span></h1>
      <div data-m-stack style="display:flex;flex-wrap:wrap;gap:18px;margin-top:8px">
        <a class="btn btn-primary on-dark" href="/">Accueil</a>
        <a class="btn btn-secondary on-dark" href="/contact/">Me contacter</a>
      </div>
    </div>
  </section>
</Base>
