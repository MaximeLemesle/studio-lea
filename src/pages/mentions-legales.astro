---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import '../styles/legal.css';
import '../styles/pages/mentions-legales.css';
import { encodeEmail } from '../lib/email';

// L'adresse vient de la variable d'environnement CONTACT_EMAIL (fichier .env, jamais publié).
// Elle n'est écrite qu'encodée dans la page et reconstituée au clic (anti-robots).
const EMAIL = encodeEmail(import.meta.env.CONTACT_EMAIL);
---

<Base title="Studio Béa — Mentions légales" footerSticker={false}>
<section class="grid-brown dark lg-hero" style="padding:64px 0 120px;color:#F7F0DC">
  <div class="wrap" style="display:flex;flex-direction:column;gap:14px">
    <nav aria-label="Fil d'Ariane" class="label" style="font-size:12px;color:#F3E9B5;display:flex;gap:10px"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><span>Mentions légales</span></nav>
    <h1 class="h1 lg-h1" style="color:#F7F0DC">Mentions<br class="m-only" /> légales</h1>
    <p class="script lg-script" data-anim="write" aria-hidden="true" style="--d:.4s;font-size:58px;color:#F3E9B5;margin:-18px 0 0 520px;transform:rotate(-4deg)">les petites lignes</p>
  </div>
</section>

<section class="grid-cream lg-main" style="padding:0 0 110px">
  <div class="wrap lg-grid" style="display:grid;grid-template-columns:300px minmax(0,1fr);gap:56px;align-items:start;margin-top:-70px">
    <nav class="lg-toc-nav" aria-label="Sommaire"><details class="postit lg-toc" open data-toc style="position:relative;padding:36px 26px 20px;transform:rotate(-1.5deg)">
      <div class="washi washi-plain" style="width:96px;top:-13px;left:50%;margin-left:-48px;transform:rotate(3deg)"></div>
      <summary><span class="label">Sommaire</span><svg class="toc-chev" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6 L8 11 L13 6" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></summary>
      <ul class="toc">
        <li><a href="#editeur"><span class="spec">01</span>Éditeur du site</a></li>
        <li><a href="#hebergeur"><span class="spec">02</span>Hébergement</a></li>
        <li><a href="#pi"><span class="spec">03</span>Propriété intellectuelle</a></li>
        <li><a href="#resp"><span class="spec">04</span>Responsabilité</a></li>
        <li><a href="#credits"><span class="spec">05</span>Crédits</a></li>
      </ul>
    </details></nav>

    <article class="doc lg-doc" style="position:relative;padding:28px 64px 30px 96px">
      <div class="washi washi-dots" style="width:130px;top:-14px;right:60px;transform:rotate(4deg)"></div>

      <section id="editeur" class="sec">
        <p class="label">01</p>
        <h2 class="h2">Éditeur du site</h2>
        <dl class="dl">
          <dt>Nom</dt><dd>Léa Audouin — nom commercial : Studio Béa</dd>
          <dt>Statut</dt><dd>Entrepreneure individuelle (micro-entreprise)</dd>
          <dt>SIRET</dt><dd>939 976 916 00014</dd>
          <dt>Adresse</dt><dd>353 chemin des Mortiers, 49770 La Membrolle-sur-Longuenée</dd>
          <dt>Contact</dt><dd style="display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px">Via le <a href="/contact/">formulaire de contact</a> ou par email : <span class="lg-email" data-email={EMAIL}></span><button type="button" data-email-btn style="display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 16px;border:2px solid #4A2018;border-radius:10px;background:#F3E9B5;color:#4A2018;font-family:'Courier Prime','Courier New',monospace;font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer"><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><rect x="1" y="1" width="16" height="12" rx="2" fill="none" stroke="#4A2018" stroke-width="1.6"></rect><path d="M1.5 2 L9 8 L16.5 2" fill="none" stroke="#4A2018" stroke-width="1.6"></path></svg>Afficher l'adresse email</button></dd>
          <dt>Publication</dt><dd>Directrice de la publication : Léa Audouin</dd>
        </dl>
      </section>

      <section id="hebergeur" class="sec">
        <p class="label">02</p>
        <h2 class="h2">Hébergement</h2>
        <dl class="dl">
          <dt>Hébergeur</dt><dd>Hostinger International Ltd</dd>
          <dt>Adresse</dt><dd>61 Lordou Vironos Street, 6023 Larnaca, Chypre</dd>
          <dt>Site</dt><dd><a href="https://www.hostinger.fr">www.hostinger.fr</a></dd>
        </dl>
      </section>

      <section id="pi" class="sec">
        <p class="label">03</p>
        <h2 class="h2">Propriété intellectuelle</h2>
        <p class="body">L'ensemble des contenus de ce site (textes, visuels, logo, mise en page) est la propriété de Léa Audouin, sauf mention contraire. Toute reproduction, même partielle, sans autorisation écrite préalable est interdite.</p>
        <p class="body">Les réalisations présentées dans le portfolio ont été créées pour des clients et sont publiées avec leur accord. Les marques et logos cités restent la propriété de leurs titulaires.</p>
      </section>

      <section id="resp" class="sec">
        <p class="label">04</p>
        <h2 class="h2">Responsabilité</h2>
        <p class="body">Les informations de ce site sont données à titre indicatif et peuvent évoluer, notamment les tarifs « à partir de », qui ne valent pas devis. Les liens vers des sites externes (Instagram, LinkedIn…) sont proposés pour information ; Studio Béa n'est pas responsable de leur contenu.</p>
      </section>

      <section id="credits" class="sec">
        <p class="label">05</p>
        <h2 class="h2">Crédits</h2>
        <p class="body">Conception, design et contenus : Léa Audouin — Studio Béa. Polices : Josefin Sans, DM Sans, Ms Madi, Caveat et Courier Prime (Google Fonts). Photos : <span class="a-completer">À compléter</span>.</p>
        <p class="spec" style="margin-top:8px">Dernière mise à jour : <span class="a-completer">À compléter</span></p>
      </section>
    </article>
  </div>
</section>
<script>
  import '../scripts/legal';
</script>
</Base>
