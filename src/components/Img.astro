---
// Image optimisée (AVIF/WebP, plusieurs tailles) qui garde les attributs de la maquette.
import { Image, Picture } from 'astro:assets';
import { getImg } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  [key: string]: unknown;
}
const { src, alt, sizes = '(max-width: 720px) 92vw, 640px', loading = 'lazy', ...attrs } = Astro.props;
const meta = getImg(src);
const widths = [360, 640, 960, 1280].filter((w) => w < meta.width).concat(meta.width);
// Aperçu en ligne (PREVIEW=1) : une seule version WebP par image, pour limiter le nombre de fichiers.
const preview = process.env.PREVIEW === '1';
---
{preview
  ? <Image src={meta} alt={alt} format="webp" width={Math.min(meta.width, 900)} loading={loading} decoding="async" {...attrs} />
  : <Picture src={meta} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} loading={loading} decoding="async" {...attrs} />}
