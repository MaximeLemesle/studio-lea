---
// Fiche projet « AP Ressources Humaines » (maquette Projet-AP-Ressources-Humaines.dc.html). Généré par tools/projets.py, puis relu.
import Img from '../Img.astro';
import { img } from '../../lib/images';

interface Props {
  /** Fiche affichée d'emblée (page /portfolio/<projet>/). */
  open?: boolean;
}
const { open = false } = Astro.props;
---
<dialog class="fiche" id="fiche-ap-ressources-humaines" aria-labelledby="titre-ap-ressources-humaines" data-fiche="ap-ressources-humaines" data-index="6" open={open} data-open-on-load={open ? '' : undefined}>
  <section class="vbox">
    <div class="washi washi-plain f-washi1" style="width:120px;top:-15px;left:70px;transform:rotate(-4deg)"></div>
    <div class="washi washi-dots f-washi2" style="width:120px;top:-15px;right:90px;transform:rotate(3deg)"></div>
    <div class="f-grab" aria-hidden="true"></div>

    <div class="f-head">
      <div class="f-head-txt">
        <p class="label f-index"><span class="d-only">Portfolio · projet</span><span class="m-only">Projet</span> 6 / 13</p>
        <h2 id="titre-ap-ressources-humaines" class="h2 f-title" style="font-size:48px">AP Ressources Humaines</h2>
      </div>
      <button class="vclose" type="button" data-fiche-close aria-label="Fermer la fiche projet"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" stroke="#4A2018" stroke-width="2.2" stroke-linecap="round"></path></svg>Fermer</button>
    </div>

    <div class="f-grid">
      <div class="f-left">
        <div class="polaroid f-cover" style="transform:rotate(-2.5deg)">
          <div class="washi washi-floral" style="width:110px;top:-14px;left:50%;margin-left:-55px;transform:rotate(3deg)"></div>
          <Img src="pf-ap-rh.jpg" alt="Goodies réalisés pour AP Ressources Humaines" style="display:block;width:100%;aspect-ratio:3/4;object-fit:cover" sizes="(max-width: 720px) 330px, 360px" />
          <p class="polaroid-cap">AP Ressources Humaines</p>
        </div>
        <dl class="f-meta" style="margin:0;display:flex;flex-direction:column;gap:14px">
          <div class="f-svcs"><dt class="label" style="font-size:11px">Services</dt><dd style="margin:8px 0 0" class="svcs"><span class="svc" style="background:#F2E3A0">Community management</span><span class="svc" style="background:#EFC9D2">Graphisme · maquettage</span><span class="svc" style="background:#CFE3C4">Rédactionnel</span></dd></div>
        </dl>
      </div>
      <div class="f-right">
        <ul class="vtabs" role="tablist" aria-label="Services réalisés pour ce client">
          <li role="presentation"><button class="vtab" type="button" role="tab" id="tab-ap-ressources-humaines-cm" aria-controls="panel-ap-ressources-humaines-cm" aria-selected="true" tabindex="0" style="background:#F2E3A0"><span class="d-only">Community management</span><span class="m-only">CM</span></button></li>
          <li role="presentation"><button class="vtab" type="button" role="tab" id="tab-ap-ressources-humaines-graphisme" aria-controls="panel-ap-ressources-humaines-graphisme" aria-selected="false" tabindex="-1" style="background:#EFC9D2">Graphisme</button></li>
          <li role="presentation"><button class="vtab" type="button" role="tab" id="tab-ap-ressources-humaines-redac" aria-controls="panel-ap-ressources-humaines-redac" aria-selected="false" tabindex="-1" style="background:#CFE3C4">Rédactionnel</button></li>
        </ul>
        <div class="vpanel dots" role="tabpanel" id="panel-ap-ressources-humaines-cm" aria-labelledby="tab-ap-ressources-humaines-cm" style="background-color:#F2E3A0">
          <div class="vsheet"><p class="label" style="font-size:11px"><span class="m-only">Community management · </span>Ce que j'ai fait</p>
            <p class="body" style="max-width:640px">J'ai géré les réseaux sociaux d'AP Ressources Humaines sur Instagram et LinkedIn : création des contenus, planification et publication.</p>
            <p class="label" style="font-size:11px;margin-top:6px">Exemples</p>
            <div class="ex-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:4px 6px 6px">
              <figure style="margin:0;display:flex;flex-direction:column;gap:12px"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-aprh-post.jpg")} aria-label="Agrandir : Reel Instagram d'AP Ressources Humaines"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(-2deg)"><Img src="pj-aprh-post.jpg" alt="Reel Instagram d'AP Ressources Humaines" style="display:block;width:100%;aspect-ratio:1179/2556;object-fit:cover" sizes="(max-width: 720px) 132px, 240px" /><p class="polaroid-cap" style="font-size:19px;bottom:8px">exemple de post</p></div></button><a class="link" href="https://www.instagram.com/p/DLAGNQYI7oD/" target="_blank" rel="noopener" style="font-size:11px;align-self:center">Voir le post ↗</a></figure>
            </div></div>
        </div>
        <div class="vpanel dots" role="tabpanel" id="panel-ap-ressources-humaines-graphisme" aria-labelledby="tab-ap-ressources-humaines-graphisme" style="background-color:#EFC9D2" hidden>
          <div class="vsheet"><p class="label" style="font-size:11px"><span class="m-only">Graphisme · </span>Ce que j'ai fait</p>
            <p class="body" style="max-width:640px">J'ai réalisé le maquettage de leur site internet, puis créé leurs goodies et leur kakemono.</p>
            <p class="label" style="font-size:11px;margin-top:6px">Exemples</p>
            <div class="ex-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:4px 6px 6px">
              <figure style="margin:0"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-aprh-maquette.jpg")} aria-label="Agrandir : Maquette du site AP Ressources Humaines dans Figma"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(-2deg)"><Img src="pj-aprh-maquette.jpg" alt="Maquette du site AP Ressources Humaines dans Figma" style="display:block;width:100%;aspect-ratio:1928/1131;object-fit:cover" sizes="(max-width: 720px) 132px, 240px" /><p class="polaroid-cap" style="font-size:19px;bottom:8px">le site</p></div></button></figure><figure style="margin:0"><button type="button" class="ex-zoom" data-zoom data-full={img("pf-ap-rh.jpg")} aria-label="Agrandir : Goodies AP Ressources Humaines : carnet, tapis de souris et gourde"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(1.5deg)"><Img src="pf-ap-rh.jpg" alt="Goodies AP Ressources Humaines : carnet, tapis de souris et gourde" style="display:block;width:100%;aspect-ratio:3/4;object-fit:cover" sizes="(max-width: 720px) 132px, 240px" /><p class="polaroid-cap" style="font-size:19px;bottom:8px">les goodies</p></div></button></figure><figure style="margin:0"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-aprh-kakemono.jpg")} aria-label="Agrandir : Kakemono AP Ressources Humaines"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(-1deg)"><Img src="pj-aprh-kakemono.jpg" alt="Kakemono AP Ressources Humaines" style="display:block;width:100%;aspect-ratio:3/4;object-fit:cover" sizes="(max-width: 720px) 132px, 240px" /><p class="polaroid-cap" style="font-size:19px;bottom:8px">le kakemono</p></div></button></figure>
            </div></div>
        </div>
        <div class="vpanel dots" role="tabpanel" id="panel-ap-ressources-humaines-redac" aria-labelledby="tab-ap-ressources-humaines-redac" style="background-color:#CFE3C4" hidden>
          <div class="vsheet"><p class="label" style="font-size:11px"><span class="m-only">Rédactionnel · </span>Ce que j'ai fait</p>
            <p class="body" style="max-width:640px">J'ai rédigé les textes de leur site internet et travaillé leur référencement naturel (SEO).</p>
            <p class="label" style="font-size:11px;margin-top:6px">Exemples</p>
            <div class="ex-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:4px 6px 6px">
              <figure style="margin:0;grid-column:1/-1;display:flex;flex-direction:column;gap:12px">
              <a href="https://www.ap-rh.com/" target="_blank" rel="noopener" aria-label="Voir le site ap-rh.com (nouvel onglet)" style="display:block;text-decoration:none;color:inherit;max-width:620px;background:#FFFDF6;border:2px solid #4A2018;border-radius:12px;overflow:hidden;box-shadow:4px 4px 0 #C9A43A">
                <div style="display:flex;align-items:center;gap:8px;padding:9px 14px;background:#ECE8DF;border-bottom:2px solid #4A2018"><span style="width:10px;height:10px;border-radius:50%;background:#EFC9D2;border:1.5px solid #4A2018"></span><span style="width:10px;height:10px;border-radius:50%;background:#F3E9B5;border:1.5px solid #4A2018"></span><span style="width:10px;height:10px;border-radius:50%;background:#CFE3C4;border:1.5px solid #4A2018"></span><span class="spec" style="margin-left:10px;padding:2px 12px;background:#FFFDF6;border-radius:999px;font-size:12px">ap-rh.com</span></div>
                <Img src="pj-aprh-site.jpg" alt="Page d'accueil du site ap-rh.com" style="display:block;width:100%;height:auto" sizes="(max-width: 720px) 132px, 240px" />
              </a>
              <a class="link" href="https://www.ap-rh.com/" target="_blank" rel="noopener" style="font-size:11px;align-self:flex-start">Voir le site ↗</a>
            </figure>
            </div></div>
        </div>
      </div>
    </div>

    <div class="f-nav">
      <a class="vnav f-prev" href="/portfolio/fitadium/" data-projet="fitadium" data-fiche-nav="prev"><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M17 7 H2 M7 1 L1 7 L7 13" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="d-only">Précédent</span><span class="nm">Fitadium</span></a>
      <a class="btn btn-primary f-cta" href="/contact/"><span class="d-only">Un projet similaire ? Écrivez-moi</span><span class="m-only">Un projet similaire ?</span></a>
      <a class="vnav f-next" href="/portfolio/oui-a-la-qualite/" data-projet="oui-a-la-qualite" data-fiche-nav="next"><span class="nm">Oui à la Qualité en Pays de la Loire</span><span class="d-only">Suivant</span><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M1 7 H16 M11 1 L17 7 L11 13" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
    </div>
  </section>
</dialog>
