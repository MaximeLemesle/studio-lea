---
// Fiche projet « Aline Lemesle » (maquette Projet-Aline-Lemesle.dc.html). Généré par tools/projets.py, puis relu.
import Img from '../Img.astro';
import { img } from '../../lib/images';

interface Props {
  /** Fiche affichée d'emblée (page /portfolio/<projet>/). */
  open?: boolean;
}
const { open = false } = Astro.props;
---
<dialog class="fiche" id="fiche-aline-lemesle" aria-labelledby="titre-aline-lemesle" data-fiche="aline-lemesle" data-index="8" open={open} data-open-on-load={open ? '' : undefined}>
  <section class="vbox">
    <div class="washi washi-plain f-washi1" style="width:120px;top:-15px;left:70px;transform:rotate(-4deg)"></div>
    <div class="washi washi-dots f-washi2" style="width:120px;top:-15px;right:90px;transform:rotate(3deg)"></div>
    <div class="f-grab" aria-hidden="true"></div>

    <div class="f-head">
      <div class="f-head-txt">
        <p class="label f-index"><span class="d-only">Portfolio · projet</span><span class="m-only">Projet</span> 8 / 13</p>
        <h2 id="titre-aline-lemesle" class="h2 f-title" style="font-size:48px">Aline Lemesle</h2>
        <p class="script f-script m-only" aria-hidden="true">en coulisses</p>
      </div>
      <button class="vclose" type="button" data-fiche-close aria-label="Fermer la fiche projet"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" stroke="#4A2018" stroke-width="2.2" stroke-linecap="round"></path></svg>Fermer</button>
    </div>

    <div class="f-grid">
      <div class="f-left">
        <div class="polaroid f-cover" style="transform:rotate(-2.5deg)">
          <div class="washi washi-floral" style="width:110px;top:-14px;left:50%;margin-left:-55px;transform:rotate(3deg)"></div>
          <Img src="services-graphisme.jpg" alt="Carte de visite réalisée pour Aline Lemesle" style="display:block;width:100%;aspect-ratio:413/300;object-fit:cover" sizes="(max-width: 720px) 330px, 360px" />
          <p class="polaroid-cap">Aline Lemesle</p>
        </div>
        <dl class="f-meta" style="margin:0;display:flex;flex-direction:column;gap:14px">
          <div class="f-svcs"><dt class="label" style="font-size:11px">Services</dt><dd style="margin:8px 0 0" class="svcs"><span class="svc" style="background:#EFC9D2">Graphisme · carte de visite</span></dd></div>
        </dl>
      </div>
      <div class="f-right">
        <ul class="vtabs" role="tablist" aria-label="Services réalisés pour ce client">
          <li role="presentation"><button class="vtab" type="button" role="tab" id="tab-aline-lemesle-graphisme" aria-controls="panel-aline-lemesle-graphisme" aria-selected="true" tabindex="0" style="background:#EFC9D2">Graphisme</button></li>
        </ul>
        <div class="vpanel dots" role="tabpanel" id="panel-aline-lemesle-graphisme" aria-labelledby="tab-aline-lemesle-graphisme" style="background-color:#EFC9D2">
          <div class="vsheet"><p class="label" style="font-size:11px"><span class="m-only">Graphisme · </span>Ce que j'ai fait</p>
            <p class="body" style="max-width:640px">J'ai créé la carte de visite d'Aline Lemesle, à son image, prête à imprimer.</p></div>
        </div>
      </div>
    </div>

    <div class="f-nav">
      <a class="vnav f-prev" href="/portfolio/oui-a-la-qualite/" data-projet="oui-a-la-qualite" data-fiche-nav="prev"><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M17 7 H2 M7 1 L1 7 L7 13" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="d-only">Précédent</span><span class="nm">Oui à la Qualité en Pays de la Loire</span></a>
      <a class="btn btn-primary f-cta" href="/contact/"><span class="d-only">Un projet similaire ? Écrivez-moi</span><span class="m-only">Un projet similaire ?</span></a>
      <a class="vnav f-next" href="/portfolio/yubo/" data-projet="yubo" data-fiche-nav="next"><span class="nm">Yubo</span><span class="d-only">Suivant</span><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M1 7 H16 M11 1 L17 7 L11 13" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
    </div>
  </section>
</dialog>
