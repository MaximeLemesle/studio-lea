---
// Fiche projet « Médusor » (maquette Projet-Medusor.dc.html). Généré par tools/projets.py, puis relu.
import Img from '../Img.astro';
import { img } from '../../lib/images';

interface Props {
  /** Fiche affichée d'emblée (page /portfolio/<projet>/). */
  open?: boolean;
}
const { open = false } = Astro.props;
---
<dialog class="fiche" id="fiche-medusor" aria-labelledby="titre-medusor" data-fiche="medusor" data-index="1" open={open} data-open-on-load={open ? '' : undefined}>
  <section class="vbox">
    <div class="washi washi-plain f-washi1" style="width:120px;top:-15px;left:70px;transform:rotate(-4deg)"></div>
    <div class="washi washi-dots f-washi2" style="width:120px;top:-15px;right:90px;transform:rotate(3deg)"></div>
    <div class="f-grab" aria-hidden="true"></div>

    <div class="f-head">
      <div class="f-head-txt">
        <p class="label f-index"><span class="d-only">Portfolio · projet</span><span class="m-only">Projet</span> 1 / 13</p>
        <h2 id="titre-medusor" class="h2 f-title" style="font-size:48px">Médusor</h2>
      </div>
      <button class="vclose" type="button" data-fiche-close aria-label="Fermer la fiche projet"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2 L12 12 M12 2 L2 12" stroke="#4A2018" stroke-width="2.2" stroke-linecap="round"></path></svg>Fermer</button>
    </div>

    <div class="f-grid">
      <div class="f-left">
        <div class="polaroid f-cover" style="transform:rotate(-2.5deg)">
          <div class="washi washi-floral" style="width:110px;top:-14px;left:50%;margin-left:-55px;transform:rotate(3deg)"></div>
          <Img src="pf-medusor.jpg" alt="Projet Médusor" style="display:block;width:100%;aspect-ratio:3/4;object-fit:cover" sizes="(max-width: 720px) 330px, 360px" />
          <p class="polaroid-cap">Médusor</p>
        </div>
        <dl class="f-meta" style="margin:0;display:flex;flex-direction:column;gap:14px">
          <div class="f-svcs"><dt class="label" style="font-size:11px">Services</dt><dd style="margin:8px 0 0" class="svcs"><span class="svc" style="background:#F2E3A0">Community management</span><span class="svc" style="background:#CFE3C4">Rédactionnel</span></dd></div>
        </dl>
      </div>
      <div class="f-right">
        <ul class="vtabs" role="tablist" aria-label="Services réalisés pour ce client">
          <li role="presentation"><button class="vtab" type="button" role="tab" id="tab-medusor-cm" aria-controls="panel-medusor-cm" aria-selected="true" tabindex="0" style="background:#F2E3A0"><span class="d-only">Community management</span><span class="m-only">CM</span></button></li>
          <li role="presentation"><button class="vtab" type="button" role="tab" id="tab-medusor-redac" aria-controls="panel-medusor-redac" aria-selected="false" tabindex="-1" style="background:#CFE3C4">Rédactionnel</button></li>
        </ul>
        <div class="vpanel dots" role="tabpanel" id="panel-medusor-cm" aria-labelledby="tab-medusor-cm" style="background-color:#F2E3A0">
          <div class="vsheet"><p class="label" style="font-size:11px"><span class="m-only">Community management · </span>Ce que j'ai fait</p>
            <p class="body" style="max-width:640px">J'ai pris en charge la communication B2B sur LinkedIn.</p>
            <p class="label" style="font-size:11px;margin-top:6px">Exemples</p>
            <div class="ex-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:4px 6px 6px">
              <figure style="margin:0;display:flex;flex-direction:column;gap:12px"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-medusor-linkedin.jpg")} aria-label="Agrandir : Post LinkedIn « Équipe des méduses » pour Médusor"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(-2deg)"><Img src="pj-medusor-linkedin.jpg" alt="Post LinkedIn « Équipe des méduses » pour Médusor" style="display:block;width:100%;aspect-ratio:1107/1948;object-fit:cover;object-position:top" sizes="(max-width: 720px) 132px, 240px" /><p class="polaroid-cap" style="font-size:19px;bottom:8px">post LinkedIn</p></div></button><a class="link" href="https://www.linkedin.com/feed/update/urn:li:activity:7423287889288945664" target="_blank" rel="noopener" style="font-size:11px;align-self:center">Voir le post ↗</a></figure>
            </div></div>
        </div>
        <div class="vpanel dots" role="tabpanel" id="panel-medusor-redac" aria-labelledby="tab-medusor-redac" style="background-color:#CFE3C4" hidden>
          <div class="vsheet"><p class="label" style="font-size:11px"><span class="m-only">Rédactionnel · </span>Ce que j'ai fait</p>
            <p class="body" style="max-width:640px">J'ai rédigé divers communiqués de presse.</p>
            <p class="label" style="font-size:11px;margin-top:6px">Exemples</p>
            <div class="ex-grid" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px;padding:4px 6px 6px">
              <figure style="margin:0"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-medusor-cp1.jpg")} aria-label="Agrandir : Communiqué de presse : annonce de la 6e édition de l'Extrême Cordouan"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(-2deg)"><Img src="pj-medusor-cp1.jpg" alt="Communiqué de presse : annonce de la 6e édition de l'Extrême Cordouan" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top" sizes="(max-width: 720px) 132px, 240px" /></div></button></figure><figure style="margin:0"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-medusor-cp2.jpg")} aria-label="Agrandir : Communiqué de presse : programme de l'Extrême Cordouan la veille de l'événement"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(1.5deg)"><Img src="pj-medusor-cp2.jpg" alt="Communiqué de presse : programme de l'Extrême Cordouan la veille de l'événement" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top" sizes="(max-width: 720px) 132px, 240px" /></div></button></figure><figure style="margin:0"><button type="button" class="ex-zoom" data-zoom data-full={img("pj-medusor-cp3.jpg")} aria-label="Agrandir : Communiqué de presse : bilan médias de l'Extrême Cordouan"><div class="polaroid" style="padding:10px 10px 40px;transform:rotate(-1deg)"><Img src="pj-medusor-cp3.jpg" alt="Communiqué de presse : bilan médias de l'Extrême Cordouan" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top" sizes="(max-width: 720px) 132px, 240px" /></div></button></figure>
            </div></div>
        </div>
      </div>
    </div>

    <div class="f-nav">
      <a class="vnav f-prev" href="/portfolio/brand-style/" data-projet="brand-style" data-fiche-nav="prev"><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M17 7 H2 M7 1 L1 7 L7 13" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><span class="d-only">Précédent</span><span class="nm">Brand Style</span></a>
      <a class="btn btn-primary f-cta" href="/contact/"><span class="d-only">Un projet similaire ? Écrivez-moi</span><span class="m-only">Un projet similaire ?</span></a>
      <a class="vnav f-next" href="/portfolio/salon-des-peches/" data-projet="salon-des-peches" data-fiche-nav="next"><span class="nm">Salon des Pêches</span><span class="d-only">Suivant</span><svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M1 7 H16 M11 1 L17 7 L11 13" fill="none" stroke="#4A2018" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
    </div>
  </section>
</dialog>
