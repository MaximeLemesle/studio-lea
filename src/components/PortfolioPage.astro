---
// Page Portfolio (maquettes Portfolio et Portfolio-mobile). Utilisée par /portfolio/
// et par chaque /portfolio/<projet>/, qui affiche la même page avec la fiche ouverte.
import Base from '../layouts/Base.astro';
import Img from './Img.astro';
import { PROJETS } from '../data/projets';
import '../styles/service.css';
import '../styles/pages/portfolio.css';

interface Props {
  /** Projet dont la fiche est ouverte au chargement. */
  open?: string;
}
const { open } = Astro.props;
const fiches = import.meta.glob<{ default: any }>('./projets/*.astro', { eager: true });
const FICHES = PROJETS.map((p) => ({ slug: p.slug, Fiche: fiches[`./projets/${p.slug}.astro`].default }));
const current = PROJETS.find((p) => p.slug === open);
const title = current ? `${current.title} · Portfolio · Studio Béa` : 'Portfolio · Studio Béa';
const description = current?.description ?? 'Découvrez mes projets : réseaux sociaux, graphisme, rédaction et vidéos UGC pour des entreprises de toute la France.';
---

<Base title={title} description={description} active="portfolio">
<!-- INTRO -->
<section class="grid-brown dark pf-hero" style="position:relative;padding:76px 0 0;color:#F7F0DC">
  <div class="wrap">
    <div class="pf-hero-grid" style="position:relative;display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:56px;align-items:end;padding-bottom:64px">
      <div style="display:flex;flex-direction:column;gap:18px">
        <nav class="crumb" aria-label="Fil d'Ariane" style="color:#F3E9B5"><a href="/" style="color:#F3E9B5">Accueil</a><span aria-hidden="true">/</span><span>Portfolio</span></nav>
        <h1 class="h1 pf-h1" style="color:#F7F0DC">Portfolio</h1>
        <p class="script pf-carnet" data-anim="write" aria-hidden="true" style="--d:.4s;font-size:72px;color:#F3E9B5;margin:-26px 0 0 300px;transform:rotate(-5deg)">le carnet de projets</p>
      </div>
      <div class="d-only" style="position:relative;display:flex;justify-content:flex-end">
        <svg class="pf-stamp" data-anim="stamp" style="--d:1s" style="transform:rotate(-12deg);opacity:.9" width="150" height="150" viewBox="0 0 130 130" aria-hidden="true"><defs><path id="arcPf" d="M65 65 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0"></path></defs><circle cx="65" cy="65" r="61" fill="none" stroke="#F3E9B5" stroke-width="2.5"></circle><circle cx="65" cy="65" r="35" fill="none" stroke="#F3E9B5" stroke-width="1.5" stroke-dasharray="3 3"></circle><text font-family="'Courier Prime', monospace" font-size="10" font-weight="700" letter-spacing="1.2" fill="#F3E9B5"><textPath href="#arcPf">STUDIO BÉA · FAIT MAIN · ANGERS · 49 · </textPath></text><path transform="translate(53 53)" d="M12 1.6l2.9 6.5 7.1.8-5.3 4.8 1.5 7-6.2-3.6-6.2 3.6 1.5-7L2 8.9l7.1-.8z" fill="#C9A43A"></path></svg>
      </div>
    </div>

    <div class="pf-filterbar" style="position:relative;display:flex;align-items:flex-end;justify-content:space-between;gap:20px;flex-wrap:wrap">
      <p class="label m-only pf-filtrer" style="font-size:11px;color:#F3E9B5">Filtrer</p>
      <ul class="tabs filters" aria-label="Filtrer par service" role="list" data-filters>
        <li><button class="tab" type="button" aria-pressed="true" data-filter="tous">Tous</button></li>
        <li><button class="tab" type="button" aria-pressed="false" data-filter="cm" style="background:#F2E3A0">Community management</button></li>
        <li><button class="tab" type="button" aria-pressed="false" data-filter="audit" style="background:#C9D6EC">Audit</button></li>
        <li><button class="tab" type="button" aria-pressed="false" data-filter="graphisme" style="background:#EFC9D2">Graphisme</button></li>
        <li><button class="tab" type="button" aria-pressed="false" data-filter="redac" style="background:#CFE3C4">Rédactionnel</button></li>
        <li><button class="tab" type="button" aria-pressed="false" data-filter="ugc" style="background:#F4D3B8">UGC</button></li>
      </ul>
      <p class="spec pf-count" style="color:#F3E9B5;padding-bottom:14px">13 projets</p>
    </div>
  </div>
</section>

